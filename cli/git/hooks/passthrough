#!/bin/bash --posix
one_line() {
    value=
    [ -f "$1" ] && [ -r "$1" ] || return 1
    status=0
    IFS= read -r -d '' value < "$1" || status=$?
    [ "$status" = 1 ] || return 1
    value=${value%$'\n'}
    case "$value" in
        *$'\r'*|*$'\n'*) return 1 ;;
    esac
    [ -n "$value" ]
}

common_dir() {
    [ "${GIT_COMMON_DIR+x}" != x ] || return 1
    if [ "${GIT_DIR+x}" = x ]; then
        [ -n "$GIT_DIR" ] || return 1
        gitdir=$GIT_DIR
    elif [ -d .git ]; then
        gitdir=.git
    elif [ -f .git ] && one_line .git; then
        case "$value" in
            'gitdir: '?*) gitdir=${value#gitdir: } ;;
            *) return 1 ;;
        esac
    else
        return 1
    fi
    [ -d "$gitdir" ] && one_line "$gitdir/HEAD" || return 1
    case "$value" in
        'ref: refs/'?*) ;;
        *[!0-9a-fA-F]*) return 1 ;;
        *) [ "${#value}" = 40 ] || [ "${#value}" = 64 ] || return 1 ;;
    esac
    common=$gitdir
    if [ -e "$gitdir/commondir" ] || [ -L "$gitdir/commondir" ]; then
        one_line "$gitdir/commondir" || return 1
        case "$value" in
            /*) common=$value ;;
            *) common=$gitdir/$value ;;
        esac
    fi
    [ -d "$common/objects" ] && [ -d "$common/refs" ]
}

if common_dir; then
    [ -e "$common/hooks/${0##*/}" ] || exit 0
elif common=$(/usr/bin/git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) &&
    [ ! -e "$common/hooks/${0##*/}" ]; then
    exit 0
fi
exec /usr/bin/python3 "${0%/*}/secret-guard.py" passthrough "${0##*/}" "$@"
