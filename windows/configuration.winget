- type: Microsoft.Windows/Registry
  name: OpenExplorerToThisPC
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: LaunchTo
    valueData:
      DWord: 1

- type: Microsoft.Windows/Registry
  name: DisableSearchBoxSuggestions
  properties:
    keyPath: HKCU\SOFTWARE\Policies\Microsoft\Windows\Explorer
    valueName: DisableSearchBoxSuggestions
    valueData:
      DWord: 1

- type: Microsoft.Windows/Registry
  name: DisableSearchHighlights
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings
    valueName: IsDynamicSearchBoxEnabled
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DisableMSACloudSearch
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings
    valueName: IsMSACloudSearchEnabled
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DisableAADCloudSearch
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings
    valueName: IsAADCloudSearchEnabled
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: HideWidgetsButton
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarDa
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DisableWindowsCopilotUser
  properties:
    keyPath: HKCU\Software\Policies\Microsoft\Windows\WindowsCopilot
    valueName: TurnOffWindowsCopilot
    valueData:
      DWord: 1

- type: Microsoft.Windows/Registry
  name: DisableWindowsCopilotMachine
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Windows\WindowsCopilot
    valueName: TurnOffWindowsCopilot
    valueData:
      DWord: 1
  metadata:
    securityContext: elevated

# WSL install. May reboot; setup.ps1 registers post-setup RunOnce before applying this config.
# Uses the Arch Linux WSL distro name from `wsl --list --online`.
- name: InstallWslComponents
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  properties:
    getScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return @{ vmcomputePresent = [bool]$svc }
    testScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return [bool]$svc
    setScript: |
      Write-Host "InstallWslComponents: running wsl --install --no-distribution..."
      $process = Start-Process -FilePath "cmd.exe" -ArgumentList "/c wsl --install --no-distribution >nul 2>&1" -Wait -PassThru
      if ($process.ExitCode -eq 3010 -or $process.ExitCode -eq 1641) {
        Write-Host "WSL installed successfully, but a system reboot is required."
      }
      elseif ($process.ExitCode -ne 0) {
        throw "InstallWslComponents: wsl --install failed with exit code $($process.ExitCode)"
      }
  metadata:
    securityContext: elevated

- name: RebootForVmp
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  dependsOn:
    - InstallWslComponents
  properties:
    getScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return @{ vmcomputePresent = [bool]$svc }
    testScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return [bool]$svc
    setScript: |
      $configFile = "${WinGetConfigRoot}\configuration.winget"
      $resumeCmd  = "winget configure --file `"$configFile`" --accept-configuration-agreements --disable-interactivity"
      $runOncePath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce'
      Set-ItemProperty -Path $runOncePath -Name 'DotfilesWingetConfigureResume' -Value $resumeCmd -Force
      Write-Host "RebootForVmp: registered RunOnce resume key."
      Restart-Computer -Force
      Start-Sleep -Seconds 60
      throw "Reboot initiated to activate Virtual Machine Platform. winget configure will resume via RunOnce on next login."
  metadata:
    securityContext: elevated

- name: InstallArchLinux
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  dependsOn:
    - RebootForVmp
  properties:
    getScript: |
      $distros = (& wsl --list --quiet 2>$null) -replace "`0", "" | ForEach-Object { $_.Trim() }
      return @{ archPresent = [bool]($distros | Where-Object { $_ -eq 'archlinux' }) }
    testScript: |
      $distros = (& wsl --list --quiet 2>$null) -replace "`0", "" | ForEach-Object { $_.Trim() }
      return [bool]($distros | Where-Object { $_ -eq 'archlinux' })
    setScript: |
      Write-Host "InstallArchLinux: running wsl --install -d archlinux --no-launch..."
      $process = Start-Process -FilePath "cmd.exe" -ArgumentList '/c wsl --install -d archlinux --no-launch' -Wait -PassThru
      if ($process.ExitCode -ne 0) {
        throw "InstallArchLinux: wsl --install -d archlinux --no-launch failed with exit code $($process.ExitCode)"
      }
  metadata:
    securityContext: elevated

- name: SetDefaultArchLinux
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  dependsOn:
    - InstallArchLinux
  properties:
    getScript: |
      $output = (& wsl --list --verbose 2>$null) -replace "`0", ""
      $defaultDistro = @($output | Where-Object { $_ -match '^\s*\*\s+(\S+)' } | ForEach-Object { $Matches[1] }) | Select-Object -First 1
      return @{ defaultDistro = $defaultDistro }
    testScript: |
      $output = (& wsl --list --verbose 2>$null) -replace "`0", ""
      $defaultDistro = @($output | Where-Object { $_ -match '^\s*\*\s+(\S+)' } | ForEach-Object { $Matches[1] }) | Select-Object -First 1
      return ($defaultDistro -eq 'archlinux')
    setScript: |
      Write-Host "SetDefaultArchLinux: setting archlinux as the default WSL distro..."
      & wsl --set-default archlinux
      if ($LASTEXITCODE -ne 0) {
        throw "SetDefaultArchLinux: wsl --set-default archlinux failed with exit code $LASTEXITCODE"
      }
  metadata:
    securityContext: elevated

- name: EnsureArchDotfilesCheckout
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  dependsOn:
    - Git
    - SetDefaultArchLinux
  properties:
    getScript: |
      $marker = (& wsl -d archlinux -- bash -lc 'test -f ~/code/dotfiles/windows/scripts/bootstrap-arch-wsl.sh && echo yes || true' 2>$null) -replace "`0", ""
      return @{ checkoutPresent = ($marker -contains 'yes') }
    testScript: |
      $marker = (& wsl -d archlinux -- bash -lc 'test -f ~/code/dotfiles/windows/scripts/bootstrap-arch-wsl.sh && echo yes || true' 2>$null) -replace "`0", ""
      return ($marker -contains 'yes')
    setScript: |
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $remoteUrl = $null

      $git = Get-Command git.exe -ErrorAction SilentlyContinue
      if ($git) {
        $remoteUrl = (& $git.Source -C $repoRoot remote get-url origin 2>$null | Select-Object -First 1)
      }

      if (-not $remoteUrl) {
        $gitConfig = Join-Path $repoRoot '.git\config'
        if (Test-Path $gitConfig) {
          $inOrigin = $false
          foreach ($line in Get-Content $gitConfig) {
            if ($line -match '^\s*\[remote "origin"\]\s*$') {
              $inOrigin = $true
              continue
            }
            if ($line -match '^\s*\[') {
              $inOrigin = $false
            }
            if ($inOrigin -and $line -match '^\s*url\s*=\s*(.+?)\s*$') {
              $remoteUrl = $Matches[1]
              break
            }
          }
        }
      }

      if ($remoteUrl -match '^git@github\.com:(.+?)(?:\.git)?$') {
        $remoteUrl = "https://github.com/$($Matches[1]).git"
      }

      if (-not $remoteUrl) {
        throw "EnsureArchDotfilesCheckout: could not determine origin remote from $repoRoot"
      }

      $checkoutScript = @'
      set -euo pipefail

      target="$HOME/code/dotfiles"

      if ! command -v git >/dev/null 2>&1; then
        if command -v pacman >/dev/null 2>&1; then
          if [ "$(id -u)" -eq 0 ]; then
            pacman -Sy --needed --noconfirm git ca-certificates
          elif command -v sudo >/dev/null 2>&1; then
            sudo pacman -Sy --needed --noconfirm git ca-certificates
          else
            echo "git is missing and sudo is unavailable in archlinux." >&2
            exit 1
          fi
        else
          echo "git is missing and pacman is unavailable in archlinux." >&2
          exit 1
        fi
      fi

      if [ -d "$target/.git" ]; then
        echo "Dotfiles checkout already exists: $target"
      else
        mkdir -p "$(dirname "$target")"
        git clone "$DOTFILES_REMOTE" "$target"
      fi

      test -f "$target/windows/scripts/bootstrap-arch-wsl.sh"
      '@
      $encodedScript = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($checkoutScript))

      Write-Host "EnsureArchDotfilesCheckout: ensuring ~/code/dotfiles exists inside archlinux..."
      & wsl -d archlinux -- env "DOTFILES_REMOTE=$remoteUrl" "DOTFILES_CHECKOUT_B64=$encodedScript" bash -lc 'printf "%s" "$DOTFILES_CHECKOUT_B64" | base64 -d | bash'
      if ($LASTEXITCODE -ne 0) {
        throw "EnsureArchDotfilesCheckout: failed with exit code $LASTEXITCODE"
      }
  metadata:
    securityContext: elevated

- name: BootstrapArchWslShell
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  dependsOn:
    - EnsureArchDotfilesCheckout
  properties:
    getScript: |
      $marker = (& wsl -d archlinux -- bash -lc 'test -f ~/.dotfiles-arch-wsl-shell-ok && echo yes || true' 2>$null)
      return @{ bootstrapped = ($marker -contains 'yes') }
    testScript: |
      $marker = (& wsl -d archlinux -- bash -lc 'test -f ~/.dotfiles-arch-wsl-shell-ok && echo yes || true' 2>$null)
      return ($marker -contains 'yes')
    setScript: |
      Write-Host "BootstrapArchWslShell: running ~/code/dotfiles/windows/scripts/bootstrap-arch-wsl.sh inside archlinux..."
      & wsl -d archlinux -- bash -lc 'set -euo pipefail; bootstrap="$HOME/code/dotfiles/windows/scripts/bootstrap-arch-wsl.sh"; test -f "$bootstrap"; chmod +x "$bootstrap"; "$bootstrap"; touch ~/.dotfiles-arch-wsl-shell-ok'
      if ($LASTEXITCODE -ne 0) {
        throw "BootstrapArchWslShell: failed with exit code $LASTEXITCODE"
      }
  metadata:
    securityContext: elevated

- name: RemoveLegacyWindowsTerminalProfile
  type: Microsoft.DSC.Transitional/PowerShellScript
  properties:
    getScript: |
      $fragmentPath = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\Fragments\Dotfiles\arch-zsh.fragment.json'
      return @{ fragmentPresent = (Test-Path $fragmentPath) }
    testScript: |
      $fragmentPath = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\Fragments\Dotfiles\arch-zsh.fragment.json'
      return (-not (Test-Path $fragmentPath))
    setScript: |
      $fragmentPath = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\Fragments\Dotfiles\arch-zsh.fragment.json'
      if (Test-Path $fragmentPath) {
        Remove-Item -Path $fragmentPath -Force
      }
