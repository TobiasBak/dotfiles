# Tobias Windows developer workstation config.
# Apply with:
# winget configure -f .\windows\configuration.winget --accept-configuration-agreements --disable-interactivity

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:

# Core tools
- type: Microsoft.WinGet/Package
  name: Terminal
  properties:
    id: Microsoft.WindowsTerminal
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: JetBrainsMonoNerdFont
  properties:
    id: DEVCOM.JetBrainsMonoNerdFont
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: PowerShell
  properties:
    id: Microsoft.PowerShell
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: Git
  properties:
    id: Git.Git
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: GitHubCLI
  dependsOn:
    - Git
  properties:
    id: GitHub.cli
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: VSCode
  properties:
    id: Microsoft.VisualStudioCode
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: NvmForWindows
  properties:
    id: CoreyButler.NVMforWindows
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: UV
  properties:
    id: astral-sh.uv
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: Eza
  properties:
    id: eza-community.eza
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: Coreutils
  properties:
    id: Microsoft.Coreutils
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: PowerToys
  properties:
    id: Microsoft.PowerToys
    source: winget
    useLatest: true

- name: PowerToysDisableFindMyMouseDoubleCtrl
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
    - PowerToys
  properties:
    getScript: |
      $settingsPath = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys\settings.json'
      $mousePath = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys\MouseUtils\settings.json'
      $findMyMouseEnabled = $null
      $activationMethod = $null
      if (Test-Path $settingsPath) {
        $settings = Get-Content $settingsPath -Raw | ConvertFrom-Json
        $findMyMouseEnabled = $settings.enabled.FindMyMouse
      }
      if (Test-Path $mousePath) {
        $mouse = Get-Content $mousePath -Raw | ConvertFrom-Json
        $activationMethod = $mouse.properties.activation_method.value
      }
      return @{ findMyMouseEnabled = $findMyMouseEnabled; activationMethod = $activationMethod }
    testScript: |
      $settingsPath = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys\settings.json'
      $mousePath = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys\MouseUtils\settings.json'
      if (-not (Test-Path $settingsPath)) { return $false }
      $settings = Get-Content $settingsPath -Raw | ConvertFrom-Json
      $disabled = $settings.enabled.FindMyMouse -eq $false
      $shortcut = $false
      if (Test-Path $mousePath) {
        $mouse = Get-Content $mousePath -Raw | ConvertFrom-Json
        $shortcut = $mouse.properties.activation_method.value -eq 3
      }
      return ($disabled -and $shortcut)
    setScript: |
      $root = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys'
      $settingsPath = Join-Path $root 'settings.json'
      $mouseDir = Join-Path $root 'MouseUtils'
      $mousePath = Join-Path $mouseDir 'settings.json'
      New-Item -ItemType Directory -Force -Path $root, $mouseDir | Out-Null

      if (Test-Path $settingsPath) {
        $settings = Get-Content $settingsPath -Raw | ConvertFrom-Json
      } else {
        $settings = [pscustomobject]@{ enabled = [pscustomobject]@{} }
      }
      if (-not $settings.PSObject.Properties['enabled']) {
        $settings | Add-Member -NotePropertyName enabled -NotePropertyValue ([pscustomobject]@{})
      }
      if ($settings.enabled.PSObject.Properties['FindMyMouse']) {
        $settings.enabled.FindMyMouse = $false
      } else {
        $settings.enabled | Add-Member -NotePropertyName FindMyMouse -NotePropertyValue $false
      }
      $settings | ConvertTo-Json -Depth 20 | Set-Content -Path $settingsPath -Encoding UTF8

      if (Test-Path $mousePath) {
        $mouse = Get-Content $mousePath -Raw | ConvertFrom-Json
      } else {
        $mouse = [pscustomobject]@{
          name = 'FindMyMouse'
          version = '1.1'
          properties = [pscustomobject]@{
            activation_method = [pscustomobject]@{ value = 3 }
            include_win_key = [pscustomobject]@{ value = $false }
            activation_shortcut = [pscustomobject]@{ win = $true; ctrl = $false; alt = $false; shift = $true; code = 70 }
            do_not_activate_on_game_mode = [pscustomobject]@{ value = $true }
            background_color = [pscustomobject]@{ value = '#80000000' }
            spotlight_color = [pscustomobject]@{ value = '#80FFFFFF' }
            spotlight_radius = [pscustomobject]@{ value = 100 }
            animation_duration_ms = [pscustomobject]@{ value = 500 }
            spotlight_initial_zoom = [pscustomobject]@{ value = 9 }
            excluded_apps = [pscustomobject]@{ value = '' }
            shaking_minimum_distance = [pscustomobject]@{ value = 1000 }
            shaking_interval_ms = [pscustomobject]@{ value = 1000 }
            shaking_factor = [pscustomobject]@{ value = 400 }
          }
        }
      }
      if (-not $mouse.PSObject.Properties['properties']) { $mouse | Add-Member -NotePropertyName properties -NotePropertyValue ([pscustomobject]@{}) }
      if ($mouse.properties.PSObject.Properties['activation_method']) {
        $mouse.properties.activation_method.value = 3
      } else {
        $mouse.properties | Add-Member -NotePropertyName activation_method -NotePropertyValue ([pscustomobject]@{ value = 3 })
      }
      $mouse | ConvertTo-Json -Depth 20 | Set-Content -Path $mousePath -Encoding UTF8

- name: PowerToysCtrlShiftSpacePowerShellTerminal
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
    - PowerToys
    - Terminal
    - PowerShell
  properties:
    getScript: |
      $root = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys'
      $settingsPath = Join-Path $root 'settings.json'
      $keyboardPath = Join-Path $root 'Keyboard Manager\default.json'
      $keyboardEnabled = $null
      $mappingPresent = $false
      if (Test-Path $settingsPath) {
        $settings = Get-Content $settingsPath -Raw | ConvertFrom-Json
        $keyboardEnabled = $settings.enabled.'Keyboard Manager'
      }
      if (Test-Path $keyboardPath) {
        $profile = Get-Content $keyboardPath -Raw | ConvertFrom-Json
        $mappingPresent = [bool]($profile.remapShortcuts.global | Where-Object {
          $_.originalKeys -eq '17;16;32' -and $_.operationType -eq 1 -and
          $_.runProgramFilePath -match 'wt\.exe$' -and $_.runProgramArgs -eq '-p PowerShell'
        })
      }
      return @{ keyboardEnabled = $keyboardEnabled; mappingPresent = $mappingPresent }
    testScript: |
      $root = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys'
      $settingsPath = Join-Path $root 'settings.json'
      $keyboardPath = Join-Path $root 'Keyboard Manager\default.json'
      if (-not (Test-Path $settingsPath) -or -not (Test-Path $keyboardPath)) { return $false }
      $settings = Get-Content $settingsPath -Raw | ConvertFrom-Json
      if ($settings.enabled.'Keyboard Manager' -ne $true) { return $false }
      $profile = Get-Content $keyboardPath -Raw | ConvertFrom-Json
      return [bool]($profile.remapShortcuts.global | Where-Object {
        $_.originalKeys -eq '17;16;32' -and $_.operationType -eq 1 -and
        $_.runProgramFilePath -match 'wt\.exe$' -and $_.runProgramArgs -eq '-p PowerShell'
      })
    setScript: |
      $root = Join-Path $env:LOCALAPPDATA 'Microsoft\PowerToys'
      $settingsPath = Join-Path $root 'settings.json'
      $keyboardDir = Join-Path $root 'Keyboard Manager'
      $keyboardSettingsPath = Join-Path $keyboardDir 'settings.json'
      $keyboardProfilePath = Join-Path $keyboardDir 'default.json'
      New-Item -ItemType Directory -Force -Path $root, $keyboardDir | Out-Null

      if (Test-Path $settingsPath) {
        $settings = Get-Content $settingsPath -Raw | ConvertFrom-Json
      } else {
        $settings = [pscustomobject]@{ enabled = [pscustomobject]@{} }
      }
      if (-not $settings.PSObject.Properties['enabled']) {
        $settings | Add-Member -NotePropertyName enabled -NotePropertyValue ([pscustomobject]@{})
      }
      if ($settings.enabled.PSObject.Properties['Keyboard Manager']) {
        $settings.enabled.'Keyboard Manager' = $true
      } else {
        $settings.enabled | Add-Member -NotePropertyName 'Keyboard Manager' -NotePropertyValue $true
      }
      $settings | ConvertTo-Json -Depth 20 | Set-Content -Path $settingsPath -Encoding UTF8

      if (Test-Path $keyboardSettingsPath) {
        $keyboardSettings = Get-Content $keyboardSettingsPath -Raw | ConvertFrom-Json
      } else {
        $keyboardSettings = [pscustomobject]@{
          properties = [pscustomobject]@{
            activeConfiguration = [pscustomobject]@{ value = 'default' }
            keyboardConfigurations = [pscustomobject]@{ value = @('default') }
            DefaultEditorShortcut = [pscustomobject]@{ win = $true; ctrl = $false; alt = $false; shift = $true; code = 81; key = '' }
            EditorShortcut = [pscustomobject]@{ win = $true; ctrl = $false; alt = $false; shift = $true; code = 81; key = '' }
            useNewEditor = $false
          }
          name = 'Keyboard Manager'
          version = '1'
        }
      }
      $keyboardSettings | ConvertTo-Json -Depth 20 | Set-Content -Path $keyboardSettingsPath -Encoding UTF8

      if (Test-Path $keyboardProfilePath) {
        $profile = Get-Content $keyboardProfilePath -Raw | ConvertFrom-Json
      } else {
        $profile = [pscustomobject]@{}
      }
      if (-not $profile.PSObject.Properties['remapKeys']) {
        $profile | Add-Member -NotePropertyName remapKeys -NotePropertyValue ([pscustomobject]@{ inProcess = @() })
      }
      if (-not $profile.PSObject.Properties['remapKeysToText']) {
        $profile | Add-Member -NotePropertyName remapKeysToText -NotePropertyValue ([pscustomobject]@{ inProcess = @() })
      }
      if (-not $profile.PSObject.Properties['remapShortcuts']) {
        $profile | Add-Member -NotePropertyName remapShortcuts -NotePropertyValue ([pscustomobject]@{ global = @(); appSpecific = @() })
      }
      if (-not $profile.remapShortcuts.PSObject.Properties['global']) {
        $profile.remapShortcuts | Add-Member -NotePropertyName global -NotePropertyValue @()
      }
      if (-not $profile.remapShortcuts.PSObject.Properties['appSpecific']) {
        $profile.remapShortcuts | Add-Member -NotePropertyName appSpecific -NotePropertyValue @()
      }
      if (-not $profile.PSObject.Properties['remapShortcutsToText']) {
        $profile | Add-Member -NotePropertyName remapShortcutsToText -NotePropertyValue ([pscustomobject]@{ global = @(); appSpecific = @() })
      }

      $wt = Get-Command wt.exe -ErrorAction SilentlyContinue
      $wtPath = if ($wt) { $wt.Source } else { Join-Path $env:LOCALAPPDATA 'Microsoft\WindowsApps\wt.exe' }
      $mapping = [pscustomobject]@{
        originalKeys = '17;16;32'
        operationType = 1
        secondKeyOfChord = 0
        runProgramElevationLevel = 0
        runProgramAlreadyRunningAction = 0
        runProgramStartWindowType = 0
        runProgramFilePath = $wtPath
        runProgramArgs = '-p PowerShell'
        runProgramStartInDir = ''
        unicodeText = '*Unsupported*'
      }

      $profile.remapShortcuts.global = @($profile.remapShortcuts.global | Where-Object { $_.originalKeys -notin @('91;32', '17;16;32') })
      $profile.remapShortcuts.global = @($profile.remapShortcuts.global) + $mapping
      $profile | ConvertTo-Json -Depth 20 | Set-Content -Path $keyboardProfilePath -Encoding UTF8

- type: Microsoft.WinGet/Package
  name: OhMyPosh
  properties:
    id: JanDeDobbeleer.OhMyPosh
    source: winget
    useLatest: true

- name: PowerShellZshLikePrompt
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
    - OhMyPosh
  properties:
    getScript: |
      $profilePath = Join-Path $HOME 'Documents\PowerShell\Microsoft.PowerShell_profile.ps1'
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $themePath = Join-Path $repoRoot 'configs\oh-my-posh\custom-zsh.omp.json'
      $line = "oh-my-posh init pwsh --config '$themePath' | Invoke-Expression"
      $present = (Test-Path $profilePath) -and ((Get-Content $profilePath -Raw) -match [regex]::Escape($line))
      return @{ profile = $profilePath; theme = $themePath; configured = $present }
    testScript: |
      $profilePath = Join-Path $HOME 'Documents\PowerShell\Microsoft.PowerShell_profile.ps1'
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $themePath = Join-Path $repoRoot 'configs\oh-my-posh\custom-zsh.omp.json'
      $line = "oh-my-posh init pwsh --config '$themePath' | Invoke-Expression"
      return ((Test-Path $themePath) -and (Test-Path $profilePath) -and ((Get-Content $profilePath -Raw) -match [regex]::Escape($line)))
    setScript: |
      $profilePath = Join-Path $HOME 'Documents\PowerShell\Microsoft.PowerShell_profile.ps1'
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $themePath = Join-Path $repoRoot 'configs\oh-my-posh\custom-zsh.omp.json'
      if (-not (Test-Path $themePath)) { throw "Oh My Posh theme not found: $themePath" }
      New-Item -ItemType Directory -Force -Path (Split-Path $profilePath -Parent) | Out-Null
      if (-not (Test-Path $profilePath)) { New-Item -ItemType File -Force -Path $profilePath | Out-Null }
      $line = "oh-my-posh init pwsh --config '$themePath' | Invoke-Expression"
      $content = Get-Content $profilePath -Raw
      if ($content -notmatch [regex]::Escape($line)) {
        Add-Content -Path $profilePath -Value "`n$line"
      }

- name: UvManagedPython
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
    - UV
  properties:
    getScript: |
      $python = uv python find 3.14 2>$null
      return @{ python = $python }
    testScript: |
      $python = uv python find 3.14 2>$null
      return [bool]$python
    setScript: |
      uv python install 3.14

# Windows settings
- type: Microsoft.Windows/Registry
  name: DeveloperMode
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock
    valueName: AllowDevelopmentWithoutDevLicense
    valueData:
      DWord: 1
  metadata:
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: LongPaths
  properties:
    keyPath: HKLM\SYSTEM\CurrentControlSet\Control\FileSystem
    valueName: LongPathsEnabled
    valueData:
      DWord: 1
  metadata:
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: DarkThemeApps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize
    valueName: AppsUseLightTheme
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DarkThemeSystem
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize
    valueName: SystemUsesLightTheme
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
