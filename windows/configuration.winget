# Tobias Windows developer workstation config.
# Apply with:
# winget configure -f .\windows\configuration.winget --accept-configuration-agreements --disable-interactivity

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:

# Windows host tools
- type: Microsoft.WinGet/Package
  name: WezTerm
  properties:
    id: wez.wezterm
    source: winget
    useLatest: true

# WinGet has regular Hack, but not Hack Nerd Font in the public package index.
# HackNerdFont below installs the Nerd-patched font that WezTerm uses.
- type: Microsoft.WinGet/Package
  name: HackFont
  properties:
    id: SourceFoundry.HackFonts
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: Git
  properties:
    id: Git.Git
    source: winget
    useLatest: true

- type: Microsoft.WinGet/Package
  name: VSCode
  properties:
    id: Microsoft.VisualStudioCode
    source: winget
    useLatest: true

- name: HackNerdFont
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
    - HackFont
  properties:
    getScript: |
      $fontName = 'Hack Nerd Font'
      $registryPaths = @(
        'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts',
        'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      )
      $installed = @($registryPaths | Where-Object { Test-Path $_ } | ForEach-Object {
        $key = Get-Item $_
        $key.GetValueNames() | Where-Object { $_ -like "$fontName*" }
      })
      return @{ installed = [bool]$installed; fonts = $installed }
    testScript: |
      $fontName = 'Hack Nerd Font'
      $registryPaths = @(
        'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts',
        'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
      )
      $installed = @($registryPaths | Where-Object { Test-Path $_ } | ForEach-Object {
        $key = Get-Item $_
        $key.GetValueNames() | Where-Object { $_ -like "$fontName*" }
      })
      return [bool]$installed
    setScript: |
      $fontName = 'Hack Nerd Font'
      $downloadUrl = 'https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Hack.zip'
      $tempDir = Join-Path ([System.IO.Path]::GetTempPath()) ('hack-nerd-font-' + [System.Guid]::NewGuid())
      $zipPath = Join-Path $tempDir 'Hack.zip'
      $extractDir = Join-Path $tempDir 'extract'
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $registryPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'

      New-Item -ItemType Directory -Force -Path $tempDir, $extractDir, $fontsDir | Out-Null
      try {
        Invoke-WebRequest -Uri $downloadUrl -OutFile $zipPath
        Expand-Archive -Path $zipPath -DestinationPath $extractDir -Force
        $fontFiles = Get-ChildItem -Path $extractDir -Recurse -File -Include '*.ttf' |
          Where-Object { $_.Name -like 'HackNerdFont-*.ttf' -and $_.Name -notlike '*Mono*' -and $_.Name -notlike '*Propo*' }
        if (-not $fontFiles) { throw "No $fontName TTF files found in the downloaded archive." }

        New-Item -Path $registryPath -Force | Out-Null
        foreach ($fontFile in $fontFiles) {
          $targetPath = Join-Path $fontsDir $fontFile.Name
          Copy-Item -LiteralPath $fontFile.FullName -Destination $targetPath -Force
          $registryName = switch -Wildcard ($fontFile.BaseName) {
            'HackNerdFont-Regular' { 'Hack Nerd Font Regular (TrueType)' }
            'HackNerdFont-Bold' { 'Hack Nerd Font Bold (TrueType)' }
            'HackNerdFont-Italic' { 'Hack Nerd Font Italic (TrueType)' }
            'HackNerdFont-BoldItalic' { 'Hack Nerd Font Bold Italic (TrueType)' }
            default { "$($fontFile.BaseName) (TrueType)" }
          }
          New-ItemProperty -Path $registryPath -Name $registryName -Value $fontFile.Name -PropertyType String -Force | Out-Null
        }

        Add-Type -Namespace Win32 -Name NativeMethods -MemberDefinition '[System.Runtime.InteropServices.DllImport("user32.dll", SetLastError=true, CharSet=System.Runtime.InteropServices.CharSet.Auto)] public static extern System.IntPtr SendMessageTimeout(System.IntPtr hWnd, uint Msg, System.IntPtr wParam, string lParam, uint fuFlags, uint uTimeout, out System.IntPtr lpdwResult);'
        $result = [IntPtr]::Zero
        [Win32.NativeMethods]::SendMessageTimeout([IntPtr]0xffff, 0x001D, [IntPtr]::Zero, 'Fonts', 0x0002, 5000, [ref]$result) | Out-Null
      } finally {
        Remove-Item -LiteralPath $tempDir -Recurse -Force -ErrorAction SilentlyContinue
      }

- name: WindowsHostConfigLinks
  type: Microsoft.DSC.Transitional/PowerShellScript
  dependsOn:
    - VSCode
    - WezTerm
  properties:
    getScript: |
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $stableRepoRoot = Join-Path $HOME '.dotfiles'
      $targets = @(
        @{ name = 'codeSettings'; path = Join-Path $env:APPDATA 'Code\User\settings.json' }
        @{ name = 'codeKeybindings'; path = Join-Path $env:APPDATA 'Code\User\keybindings.json' }
        @{ name = 'weztermConfig'; path = Join-Path $HOME '.wezterm.lua' }
      )
      $present = @{}
      foreach ($target in $targets) {
        $present[$target.name] = Test-Path -LiteralPath $target.path
      }
      return @{
        repoRoot = $repoRoot
        stableRepoRoot = $stableRepoRoot
        stablePresent = Test-Path -LiteralPath $stableRepoRoot
        targets = $present
      }
    testScript: |
      function Get-NormalizedPath {
        param([Parameter(Mandatory=$true)][string]$Path)
        return [System.IO.Path]::GetFullPath($ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Path))
      }
      function Test-LinkTarget {
        param(
          [Parameter(Mandatory=$true)][string]$Path,
          [Parameter(Mandatory=$true)][string]$ExpectedTarget
        )
        if (-not (Test-Path -LiteralPath $Path) -or -not (Test-Path -LiteralPath $ExpectedTarget)) { return $false }
        $item = Get-Item -LiteralPath $Path -Force
        if (-not $item.LinkType) { return $false }
        return ((Get-NormalizedPath ($item.Target -join ';')) -eq (Get-NormalizedPath $ExpectedTarget))
      }

      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $stableRepoRoot = Join-Path $HOME '.dotfiles'
      $effectiveRepoRoot = if (Test-LinkTarget $stableRepoRoot $repoRoot) { $stableRepoRoot } else { $repoRoot }
      $expectedLinks = @(
        @{ path = Join-Path $env:APPDATA 'Code\User\settings.json'; target = Join-Path $effectiveRepoRoot 'configs\Code\User\settings.json' }
        @{ path = Join-Path $env:APPDATA 'Code\User\keybindings.json'; target = Join-Path $effectiveRepoRoot 'configs\Code\User\keybindings.json' }
        @{ path = Join-Path $HOME '.wezterm.lua'; target = Join-Path $effectiveRepoRoot 'configs\wezterm\wezterm.lua' }
      )
      $missingLinks = @($expectedLinks | Where-Object { -not (Test-LinkTarget $_.path $_.target) })
      return ((Test-LinkTarget $stableRepoRoot $repoRoot) -and $missingLinks.Count -eq 0)
    setScript: |
      $repoRoot = [System.IO.Path]::GetFullPath((Split-Path "${WinGetConfigRoot}" -Parent))
      $stableRepoRoot = Join-Path $HOME '.dotfiles'
      $backupDir = Join-Path $HOME ('dotfiles_backup_' + (Get-Date -Format 'yyyyMMdd_HHmmss'))

      function Get-NormalizedPath {
        param([Parameter(Mandatory=$true)][string]$Path)
        return [System.IO.Path]::GetFullPath($ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Path))
      }
      function Ensure-DotfilesLink {
        if (Test-Path -LiteralPath $stableRepoRoot) {
          $item = Get-Item -LiteralPath $stableRepoRoot -Force
          if ($item.LinkType) {
            if ((Get-NormalizedPath ($item.Target -join ';')) -eq (Get-NormalizedPath $repoRoot)) {
              return $stableRepoRoot
            }
            Remove-Item -LiteralPath $stableRepoRoot -Force
          } else {
            Write-Warning "$stableRepoRoot exists and is not a link. Config links will use $repoRoot."
            return $repoRoot
          }
        }
        try {
          New-Item -ItemType SymbolicLink -Path $stableRepoRoot -Target $repoRoot | Out-Null
        } catch {
          New-Item -ItemType Junction -Path $stableRepoRoot -Target $repoRoot | Out-Null
        }
        return $stableRepoRoot
      }
      function Link-DotfileConfig {
        param(
          [Parameter(Mandatory=$true)][string]$Source,
          [Parameter(Mandatory=$true)][string]$Target
        )
        if (-not (Test-Path -LiteralPath $Source)) { throw "Source does not exist: $Source" }
        $sourcePath = Get-NormalizedPath $Source
        New-Item -ItemType Directory -Force -Path (Split-Path $Target -Parent) | Out-Null

        if (Test-Path -LiteralPath $Target) {
          $item = Get-Item -LiteralPath $Target -Force
          if ($item.LinkType -and (Get-NormalizedPath ($item.Target -join ';')) -eq $sourcePath) { return }
          New-Item -ItemType Directory -Force -Path $backupDir | Out-Null
          $backupName = (Get-NormalizedPath $Target) -replace '[:\\/]', '__'
          $backupTarget = Join-Path $backupDir $backupName
          $baseBackupTarget = $backupTarget
          $counter = 1
          while (Test-Path -LiteralPath $backupTarget) {
            $backupTarget = "$baseBackupTarget.$counter"
            $counter++
          }
          Move-Item -LiteralPath $Target -Destination $backupTarget -Force
        }

        New-Item -ItemType SymbolicLink -Path $Target -Target $sourcePath | Out-Null
      }

      $effectiveRepoRoot = Ensure-DotfilesLink
      $configsDir = Join-Path $effectiveRepoRoot 'configs'
      Link-DotfileConfig (Join-Path $configsDir 'Code\User\settings.json') (Join-Path $env:APPDATA 'Code\User\settings.json')
      Link-DotfileConfig (Join-Path $configsDir 'Code\User\keybindings.json') (Join-Path $env:APPDATA 'Code\User\keybindings.json')
      Link-DotfileConfig (Join-Path $configsDir 'wezterm\wezterm.lua') (Join-Path $HOME '.wezterm.lua')

- name: RemoveLegacyPowerShellProfileDotfilesHooks
  type: Microsoft.DSC.Transitional/PowerShellScript
  properties:
    getScript: |
      $profilePaths = @(
        $PROFILE.CurrentUserCurrentHost
        (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\Microsoft.PowerShell_profile.ps1')
        (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'WindowsPowerShell\Microsoft.PowerShell_profile.ps1')
      ) | Select-Object -Unique
      $stalePatterns = @(
        '^\s*\.\s+"[^"]*\\configs\\powershell\\aliases\.ps1"\s*$'
        "^\s*oh-my-posh\s+init\s+pwsh\s+--config\s+'[^']*\\configs\\oh-my-posh\\custom-zsh\.omp\.json'\s+\|\s+Invoke-Expression\s*$"
      )
      $staleLines = @()
      foreach ($profilePath in $profilePaths) {
        if (-not (Test-Path -LiteralPath $profilePath)) { continue }
        foreach ($line in Get-Content -LiteralPath $profilePath) {
          foreach ($pattern in $stalePatterns) {
            if ($line -match $pattern) {
              $staleLines += "$profilePath`: $line"
              break
            }
          }
        }
      }
      return @{ profilePaths = $profilePaths; staleLines = $staleLines }
    testScript: |
      $profilePaths = @(
        $PROFILE.CurrentUserCurrentHost
        (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\Microsoft.PowerShell_profile.ps1')
        (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'WindowsPowerShell\Microsoft.PowerShell_profile.ps1')
      ) | Select-Object -Unique
      $stalePatterns = @(
        '^\s*\.\s+"[^"]*\\configs\\powershell\\aliases\.ps1"\s*$'
        "^\s*oh-my-posh\s+init\s+pwsh\s+--config\s+'[^']*\\configs\\oh-my-posh\\custom-zsh\.omp\.json'\s+\|\s+Invoke-Expression\s*$"
      )
      foreach ($profilePath in $profilePaths) {
        if (-not (Test-Path -LiteralPath $profilePath)) { continue }
        foreach ($line in Get-Content -LiteralPath $profilePath) {
          foreach ($pattern in $stalePatterns) {
            if ($line -match $pattern) { return $false }
          }
        }
      }
      return $true
    setScript: |
      $profilePaths = @(
        $PROFILE.CurrentUserCurrentHost
        (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\Microsoft.PowerShell_profile.ps1')
        (Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'WindowsPowerShell\Microsoft.PowerShell_profile.ps1')
      ) | Select-Object -Unique
      $stalePatterns = @(
        '^\s*\.\s+"[^"]*\\configs\\powershell\\aliases\.ps1"\s*$'
        "^\s*oh-my-posh\s+init\s+pwsh\s+--config\s+'[^']*\\configs\\oh-my-posh\\custom-zsh\.omp\.json'\s+\|\s+Invoke-Expression\s*$"
      )
      foreach ($profilePath in $profilePaths) {
        if (-not (Test-Path -LiteralPath $profilePath)) { continue }
        $lines = @(Get-Content -LiteralPath $profilePath)
        $filtered = @()
        foreach ($line in $lines) {
          $stale = $false
          foreach ($pattern in $stalePatterns) {
            if ($line -match $pattern) {
              $stale = $true
              break
            }
          }
          if (-not $stale) { $filtered += $line }
        }
        if ($filtered.Count -ne $lines.Count) {
          Set-Content -LiteralPath $profilePath -Value $filtered -Encoding UTF8
        }
      }

# Windows settings
- type: Microsoft.Windows/Registry
  name: DeveloperMode
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock
    valueName: AllowDevelopmentWithoutDevLicense
    valueData:
      DWord: 1
  metadata:
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: LongPaths
  properties:
    keyPath: HKLM\SYSTEM\CurrentControlSet\Control\FileSystem
    valueName: LongPathsEnabled
    valueData:
      DWord: 1
  metadata:
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: DarkThemeApps
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize
    valueName: AppsUseLightTheme
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DarkThemeSystem
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize
    valueName: SystemUsesLightTheme
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: ShowFileExtensions
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: HideFileExt
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: ShowHiddenFiles
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: Hidden
    valueData:
      DWord: 1

- type: Microsoft.Windows/Registry
  name: OpenExplorerToThisPC
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: LaunchTo
    valueData:
      DWord: 1

- type: Microsoft.Windows/Registry
  name: DisableSearchBoxSuggestions
  properties:
    keyPath: HKCU\SOFTWARE\Policies\Microsoft\Windows\Explorer
    valueName: DisableSearchBoxSuggestions
    valueData:
      DWord: 1

- type: Microsoft.Windows/Registry
  name: DisableSearchHighlights
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings
    valueName: IsDynamicSearchBoxEnabled
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DisableMSACloudSearch
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings
    valueName: IsMSACloudSearchEnabled
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DisableAADCloudSearch
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\SearchSettings
    valueName: IsAADCloudSearchEnabled
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: HideWidgetsButton
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarDa
    valueData:
      DWord: 0

- type: Microsoft.Windows/Registry
  name: DisableWindowsCopilotUser
  properties:
    keyPath: HKCU\Software\Policies\Microsoft\Windows\WindowsCopilot
    valueName: TurnOffWindowsCopilot
    valueData:
      DWord: 1

- type: Microsoft.Windows/Registry
  name: DisableWindowsCopilotMachine
  properties:
    keyPath: HKLM\Software\Policies\Microsoft\Windows\WindowsCopilot
    valueName: TurnOffWindowsCopilot
    valueData:
      DWord: 1
  metadata:
    securityContext: elevated

# WSL install. May reboot; this config registers its own winget resume RunOnce.
# NixOS itself is installed from the NixOS-WSL release artifact because it is not
# a standard `wsl --install -d` online distribution.
- name: InstallWslComponents
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  properties:
    getScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return @{ vmcomputePresent = [bool]$svc }
    testScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return [bool]$svc
    setScript: |
      Write-Host "InstallWslComponents: running wsl --install --no-distribution..."
      $process = Start-Process -FilePath "cmd.exe" -ArgumentList "/c wsl --install --no-distribution >nul 2>&1" -Wait -PassThru
      if ($process.ExitCode -eq 3010 -or $process.ExitCode -eq 1641) {
        Write-Host "WSL installed successfully, but a system reboot is required."
      }
      elseif ($process.ExitCode -ne 0) {
        throw "InstallWslComponents: wsl --install failed with exit code $($process.ExitCode)"
      }
  metadata:
    securityContext: elevated

- name: RebootForVmp
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  dependsOn:
    - InstallWslComponents
  properties:
    getScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return @{ vmcomputePresent = [bool]$svc }
    testScript: |
      $svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='vmcompute'"
      return [bool]$svc
    setScript: |
      $configFile = "${WinGetConfigRoot}\configuration.winget"
      $resumeCmd  = "winget configure --file `"$configFile`" --accept-configuration-agreements --disable-interactivity"
      $runOncePath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce'
      Set-ItemProperty -Path $runOncePath -Name 'DotfilesWingetConfigureResume' -Value $resumeCmd -Force
      Write-Host "RebootForVmp: registered RunOnce resume key."
      Restart-Computer -Force
      Start-Sleep -Seconds 60
      throw "Reboot initiated to activate Virtual Machine Platform. winget configure will resume via RunOnce on next login."
  metadata:
    securityContext: elevated

- name: ConfigureNixOsWsl
  type: Microsoft.DSC.Transitional/WindowsPowerShellScript
  dependsOn:
    - Git
    - RebootForVmp
  properties:
    getScript: |
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $script = Join-Path $repoRoot 'windows\scripts\install-nixos-wsl.ps1'
      if (-not (Test-Path -LiteralPath $script)) {
        return @{ installed = $false; error = "Missing $script" }
      }
      return & $script -Mode Get
    testScript: |
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $script = Join-Path $repoRoot 'windows\scripts\install-nixos-wsl.ps1'
      if (-not (Test-Path -LiteralPath $script)) { return $false }
      return [bool](& $script -Mode Test)
    setScript: |
      $repoRoot = Split-Path "${WinGetConfigRoot}" -Parent
      $script = Join-Path $repoRoot 'windows\scripts\install-nixos-wsl.ps1'
      if (-not (Test-Path -LiteralPath $script)) {
        throw "ConfigureNixOsWsl: missing $script"
      }
      & $script -Mode Set
      if ($LASTEXITCODE -ne 0) {
        throw "ConfigureNixOsWsl: failed with exit code $LASTEXITCODE"
      }
  metadata:
    securityContext: elevated

- name: RemoveLegacyWindowsTerminalProfile
  type: Microsoft.DSC.Transitional/PowerShellScript
  properties:
    getScript: |
      $fragmentPath = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\Fragments\Dotfiles\arch-zsh.fragment.json'
      return @{ fragmentPresent = (Test-Path $fragmentPath) }
    testScript: |
      $fragmentPath = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\Fragments\Dotfiles\arch-zsh.fragment.json'
      return (-not (Test-Path $fragmentPath))
    setScript: |
      $fragmentPath = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows Terminal\Fragments\Dotfiles\arch-zsh.fragment.json'
      if (Test-Path $fragmentPath) {
        Remove-Item -Path $fragmentPath -Force
      }
