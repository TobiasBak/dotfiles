# Standalone Home Manager config for the pc under Omarchy. Omarchy owns the
# desktop (Hyprland, Waybar and their configs); this module owns the shell,
# agent configs, developer tools and the T3 user units, as on NixOS.
{
  config,
  hunk,
  pkgs,
  ...
}:

let
  developerCli = import ../../packages/developer-cli.nix { inherit hunk pkgs; };
in

{
  imports = [
    ./common.nix
    ./t3-backup.nix
    ./workstation.nix
  ];

  targets.genericLinux.enable = true;
  programs.home-manager.enable = true;

  # pacman supplies zsh, OpenSSH, Tailscale, uv and the browser; see omarchy/packages.txt.
  home.packages = developerCli.portable;
  home.sessionVariables.ZSH = "${pkgs.oh-my-zsh}/share/oh-my-zsh";

  # The repository's .zshrc is not generated by Home Manager, so load the
  # session variables (Nix profile, ZSH) the way NixOS's /etc/zshenv does.
  home.file.".zshenv".text = ''
    . "${config.home.profileDirectory}/etc/profile.d/hm-session-vars.sh"
  '';

  # workstation.nix's taildrop-receiver owns `tailscale file get`; mask
  # Omarchy's own receiver so the two never compete for incoming files.
  home.file.".config/systemd/user/omarchy-tailscale-receive.service".source =
    config.lib.file.mkOutOfStoreSymlink "/dev/null";
}
