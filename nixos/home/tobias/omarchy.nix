# Standalone Home Manager config for the pc under Omarchy. Omarchy owns the
# desktop (Hyprland, Waybar and their configs); this module owns the shell,
# agent configs, developer tools and the T3 user units, as on NixOS.
{
  config,
  hunk,
  lib,
  pkgs,
  username,
  ...
}:

let
  developerCli = import ../../packages/developer-cli.nix { inherit hunk pkgs; };
in

{
  imports = [
    ./common.nix
    ./t3-backup.nix
    ./workstation.nix
  ];

  # common.nix names the NixOS user; Omarchy's installer may have made another.
  home.username = lib.mkForce username;
  home.homeDirectory = lib.mkForce "/home/${username}";

  targets.genericLinux.enable = true;
  programs.home-manager.enable = true;

  # pacman supplies zsh, OpenSSH, Tailscale, uv and the browser; see omarchy/packages.txt.
  # mise owns Node, pnpm and the agent CLIs on Omarchy (see omarchy/bootstrap.sh).
  home.packages = lib.filter (
    p:
    !builtins.elem p [
      pkgs.nodejs
      pkgs.pnpm
    ]
  ) developerCli.portable;
  home.sessionVariables.ZSH = "${pkgs.oh-my-zsh}/share/oh-my-zsh";

  # The repository's .zshrc is not generated by Home Manager, so load the
  # session variables (Nix profile, ZSH) the way NixOS's /etc/zshenv does.
  home.file.".zshenv".text = ''
    . "${config.home.profileDirectory}/etc/profile.d/hm-session-vars.sh"
  '';

  # Keep T3 Code's CLI and background service on the newest nightly. The
  # script restarts the service only when the version changed.
  systemd.user.services.t3code-update = {
    Unit = {
      Description = "Update T3 Code to the newest nightly";
      StartLimitIntervalSec = "6h";
      StartLimitBurst = 3;
    };
    Service = {
      Type = "oneshot";
      Slice = "background.slice";
      ExecStart = "${pkgs.bash}/bin/bash ${config.home.homeDirectory}/.dotfiles/omarchy/t3-nightly.sh";
      Restart = "on-failure";
      RestartSec = "15min";
    };
  };
  systemd.user.timers.t3code-update = {
    Unit.Description = "Update T3 Code to the newest nightly every morning";
    Timer = {
      # After the 04:00 T3 backup.
      OnCalendar = "*-*-* 05:00:00";
      Persistent = true;
    };
    Install.WantedBy = [ "timers.target" ];
  };

  # workstation.nix's taildrop-receiver owns `tailscale file get`; mask
  # Omarchy's own receiver so the two never compete for incoming files.
  home.file.".config/systemd/user/omarchy-tailscale-receive.service".source =
    config.lib.file.mkOutOfStoreSymlink "/dev/null";
}
