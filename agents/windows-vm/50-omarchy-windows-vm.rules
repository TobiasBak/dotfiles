// Let tb run Omarchy's privileged Windows VM actions without a password, so
// agents can start the VM while Tobias is away. Omarchy's bind mounts vanish
// at every reboot and only `omarchy-windows-vm __priv up` recreates them.
//
// No local or active session is required: agents run without a seat. The
// script allowlists its __priv sub-actions and refuses caller-supplied mount
// paths. tb is in the docker group, which is already root-equivalent, so this
// widens nothing in practice.
//
// Installed as /etc/polkit-1/rules.d/50-omarchy-windows-vm.rules (root, 0644).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/omarchy-windows-vm" &&
        action.lookup("command_line").indexOf("/usr/bin/omarchy-windows-vm __priv ") == 0 &&
        subject.user == "tb") {
        return polkit.Result.YES;
    }
});
