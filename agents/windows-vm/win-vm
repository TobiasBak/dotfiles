READINESS_SECONDS = 60
# Conservative admission estimate for QEMU, container services and host charges.
# This is not a measured upper bound or a cgroup hard limit.
STARTUP_OVERHEAD = 1024**3
ADMISSION_CLASSES = ("gate", "interactive", "efficiency")


class Failure(Exception):
    pass


class Leased(Failure):
    pass


class TransportFailure(Failure):
    pass


class ReadinessExpired(Failure):
    pass


@contextmanager
def readiness_window(timeout):
    if timeout <= 0:
        raise ReadinessExpired("session readiness deadline exhausted")
    started = time.monotonic()
    previous_timer = signal.getitimer(signal.ITIMER_REAL)
    def expired(signum, frame):
        raise ReadinessExpired(f"session readiness deadline exhausted after {timeout:g}s")
    previous_handler = signal.signal(signal.SIGALRM, expired)
    duration = min(timeout, previous_timer[0]) if previous_timer[0] else timeout
    signal.setitimer(signal.ITIMER_REAL, duration)
    try:
        yield started + duration
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        if previous_timer[0]:
            signal.setitimer(signal.ITIMER_REAL, max(0, previous_timer[0] - (time.monotonic() - started)), previous_timer[1])


def run(argv, **kwargs):
    return subprocess.run(argv, **kwargs)


def docker_state():
    template = '{{.State.Status}}|{{.State.StartedAt}}|{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}|{{range .Mounts}}{{if eq .Destination "/storage"}}{{.Source}}{{end}}{{end}}'
    result = run(["docker", "inspect", "-f", template, CONTAINER], capture_output=True, text=True)
    if result.returncode:
        if "no such" in result.stderr.lower():
            return {"container": "absent", "ip": None, "started_at": None, "mode": "persistent"}
        raise Failure(result.stderr.strip() or "docker inspect failed")
    state, started_at, addresses, storage = result.stdout.strip().split("|")
    ips = addresses.split()
    if len(ips) > 1:
        raise Failure("VM has multiple network IPs; refusing an ambiguous SSH target")
    return {"container": state, "ip": ips[0] if ips else None, "started_at": started_at,
            "mode": "ephemeral" if storage == str(EPHEMERAL / "storage") else "persistent"}


def owned(state):
    return (state["container"] == "running" and MARKER.is_file()
            and MARKER.read_text().strip() == state["started_at"])


def credentials():
    data = {}
    for line in (KEYS / "windows-vm.env").read_text().splitlines():
        key, sep, value = line.partition("=")
        if sep:
            data[key] = value
    user = data.get("WINDOWS_VM_USERNAME", "")
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,20}", user):
        raise Failure("invalid WINDOWS_VM_USERNAME in ~/.keys/windows-vm.env")
    return user, data.get("WINDOWS_VM_PASSWORD", "")


def ps_string(value):
    return "'" + str(value).replace("'", "''") + "'"


def ssh_options():
    return ["-F", "none", "-i", str(KEYS / "windows-vm-agent"), "-o", "IdentitiesOnly=yes",
            "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
            "-o", "HostKeyAlias=omarchy-windows-vm",
            "-o", f"UserKnownHostsFile={KEYS / 'windows-vm-known_hosts'}",
            "-o", "StrictHostKeyChecking=accept-new"]


def permanent_ssh_error(error):
    text = error.casefold()
    return any(marker in text for marker in (
        "bad owner or permissions", "bad configuration option", "unsupported option",
        "unprotected private key file", "are too open", "load key ", "identity file ",
        "host key verification failed", "remote host identification has changed",
    )) or ("permission denied" in text and ("could not open" in text or "ssh: connect to host" in text))


def decode_clixml(raw):
    text = raw.decode("utf-8", errors="replace")
    if "#< CLIXML" not in text:
        return text
    prefix, _, xml = text.partition("#< CLIXML")
    try:
        root = ET.fromstring(xml.strip())
        messages = []
        for node in root:
            if node.attrib.get("S", "").lower() == "progress":
                continue
            if node.tag.rsplit("}", 1)[-1] == "S" and node.text:
                messages.append(re.sub(r"_x([0-9A-Fa-f]{4})_", lambda m: chr(int(m[1], 16)), node.text))
        return prefix + "".join(messages)
    except ET.ParseError:
        return prefix + xml


def stderr_stream(stream):
    clixml = bytearray()
    for line in iter(stream.readline, b""):
        if clixml or line.startswith(b"#< CLIXML"):
            clixml.extend(line)
        else:
            sys.stderr.buffer.write(line)
            sys.stderr.buffer.flush()
    if clixml:
        sys.stderr.write(decode_clixml(bytes(clixml)))
        sys.stderr.flush()


def powershell(ip, script, stream=False, timeout=30):
    if os.environ.get("WIN_VM_LEASE"):
        ip = leased_state()["ip"]
    user, _ = credentials()
    if not ip:
        raise Failure("Windows VM has no container IP; run win-vm up")
    script = "[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false); $OutputEncoding=[Console]::OutputEncoding; " + script
    encoded = base64.b64encode(script.encode("utf-16le")).decode()
    argv = ["ssh", *ssh_options(), f"{user}@{ip}",
            "powershell", "-NoProfile", "-NonInteractive", "-EncodedCommand", encoded]
    if stream:
        process = subprocess.Popen(argv, stderr=subprocess.PIPE)
        reader = threading.Thread(target=stderr_stream, args=(process.stderr,))
        reader.start()
        code = process.wait()
        reader.join()
        return code
    try:
        result = run(argv, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise TransportFailure(f"guest SSH control command timed out after {timeout:g}s") from None
    error = decode_clixml(result.stderr)
    if result.returncode == 255 and permanent_ssh_error(error):
        raise Failure(f"SSH client failed: {error.strip()}")
    return result.returncode, result.stdout.decode("utf-8-sig", errors="replace"), error


def remote(ip, script, timeout=30):
    code, out, err = powershell(ip, "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; " + script, timeout=timeout)
    if code:
        failure = TransportFailure if code == 255 else Failure
        raise failure(err.strip() or out.strip() or f"SSH PowerShell exited {code}")
    return out.strip()


def job_query(ip, script, deadline):
    health_deadline = None
    interrupted = False
    while True:
        remaining = (deadline if health_deadline is None else health_deadline) - time.monotonic()
        if remaining <= 0:
            raise TransportFailure("guest control unavailable within the 30s health window or job deadline; job was not resubmitted")
        try:
            result = remote(ip, script, timeout=min(30, remaining))
            if interrupted:
                print("win-vm: guest control recovered; observing the same scheduled job", file=sys.stderr)
            return result
        except TransportFailure as error:
            if health_deadline is None:
                health_deadline = min(deadline, time.monotonic() + 30)
            if not interrupted:
                print(f"win-vm: guest control interrupted; checking the same scheduled job: {error}", file=sys.stderr)
                interrupted = True
            remaining = health_deadline - time.monotonic()
            if remaining <= 0:
                raise TransportFailure(f"guest control unavailable; job was not resubmitted: {error}") from error
            time.sleep(min(1, remaining))


def session(ip, timeout=30):
    user, _ = credentials()
    if timeout <= 0:
        raise TransportFailure("guest session observation exhausted its readiness deadline")
    code, out, err = powershell(ip, "$ErrorActionPreference='Stop'; & query.exe session 2>&1; exit $LASTEXITCODE", timeout=min(30, timeout))
    if code == 255:
        raise TransportFailure(err.strip() or "guest SSH exited 255 without a diagnostic")
    try:
        return True, parse_session(out, user)
    except Failure as error:
        detail = (err.strip() or out.strip())[:2000]
        raise Failure(f"guest session query invalid ({code}): {error}; {detail}") from error


def parse_session(output, user):
    lines = [line for line in output.splitlines() if line.strip()]
    if not lines or lines[0].split() != ["SESSIONNAME", "USERNAME", "ID", "STATE", "TYPE", "DEVICE"]:
        raise Failure("missing or invalid session table header")
    if len(lines) == 1:
        raise Failure("session table has no rows")
    states = {"active", "conn", "connected", "connq", "connectquery", "shadow", "disc",
              "disconnected", "idle", "listen", "reset", "down", "init"}
    matches = []
    for line in lines[1:]:
        fields = line.lstrip(" >").split()
        positions = [i for i, field in enumerate(fields[:-1])
                     if i <= 2 and field.isdigit() and fields[i + 1].casefold() in states]
        if len(positions) != 1:
            raise Failure("unrecognized session table row")
        index = positions[0]
        prefix = fields[:index]
        row_user = prefix[-1] if prefix else ""
        if row_user.casefold() != user.casefold() or int(fields[index]) == 0:
            continue
        name = prefix[0].casefold() if len(prefix) == 2 else ""
        state = fields[index + 1].casefold()
        if state in ("disc", "disconnected"):
            kind = "disconnected"
        elif state == "active" and name == "console":
            kind = "console"
        elif state == "active" and name.startswith("rdp-"):
            kind = "rdp"
        else:
            kind = "inactive"
        matches.append({"state": kind, "id": int(fields[index]), "name": name})
    if not matches:
        return {"state": "none", "id": None, "name": None}
    matches.sort(key=lambda s: {"console": 0, "rdp": 1, "disconnected": 2, "inactive": 3}[s["state"]])
    return matches[0]


def active_session(sess):
    return sess is not None and sess["state"] in ("console", "rdp")


def status(state=None, timeout=30):
    state = state or docker_state()
    error = None
    try:
        ssh, sess = session(state["ip"], timeout) if state["container"] == "running" and state["ip"] else (False, None)
    except TransportFailure as failure:
        ssh, sess, error = False, None, str(failure)
    baseline = read_json(BASELINE / "baseline.json")
    holder = live_lease()
    return {**({"ssh_error": error} if error else {}), "container": state["container"], "ip": state["ip"], "ssh": ssh,
            "session": sess, "started_by_win_vm": owned(state), "mode": state["mode"],
            "lease": {key: holder.get(key) for key in ("pid", "command", "started_at")} if holder is not None else None,
            "baseline": {"captured_at": baseline["captured_at"],
                         "data.img": baseline["files"]["data.img"][:12]} if baseline else None}


@contextmanager
def lifecycle_lock():
    try:
        fd = os.open(VM_LOCK, os.O_RDONLY | os.O_DIRECTORY)
    except FileNotFoundError:
        yield False
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield fd
    finally:
        os.close(fd)


@contextmanager
def private_lock(name):
    CACHE.mkdir(parents=True, exist_ok=True)
    fd = os.open(CACHE / name, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield fd
    finally:
        os.close(fd)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None


def live_lease():
    try:
        fd = os.open(LEASE, os.O_RDONLY)
    except FileNotFoundError:
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return read_json(HOLDER) or {}
        return None
    finally:
        os.close(fd)


def take_lease(fd, kind):
    try:
        fcntl.flock(fd, kind | fcntl.LOCK_NB)
    except BlockingIOError:
        holder = read_json(HOLDER) or {}
        raise Leased(f"VM leased by pid {holder.get('pid', 'unknown')}, command {holder.get('command', 'unknown')}, started at {holder.get('started_at', 'unknown')}") from None


def write_holder(holder):
    fd, name = tempfile.mkstemp(prefix=".lease-", dir=STATE)
    try:
        with os.fdopen(fd, "w") as file:
            file.write(json.dumps(holder) + "\n")
        os.replace(name, HOLDER)
    finally:
        Path(name).unlink(missing_ok=True)


def leased_state():
    holder = live_lease()
    state = docker_state()
    if not holder or holder.get("token") != os.environ.get("WIN_VM_LEASE") or state["container"] != "running" or state["mode"] != "ephemeral":
        raise Failure("the ephemeral VM is gone; refusing to touch the persistent VM")
    return state


@contextmanager
def command_lease(command):
    token = os.environ.get("WIN_VM_LEASE")
    if token:
        if command in ("run", "baseline", "down"):
            raise Failure(f"{command} is refused inside an ephemeral run (no nested runs or VM lifecycle changes)")
        leased_state()
        yield None
        return
    STATE.mkdir(parents=True, exist_ok=True)
    fd = os.open(LEASE, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        kind = fcntl.LOCK_EX if command in ("run", "baseline") else fcntl.LOCK_SH
        take_lease(fd, kind)
        recover(fd, kind)
        yield fd
    finally:
        os.close(fd)


def recover(fd, kind):
    # A run whose client and guardian both died (host reboot) leaves its clone behind.
    clone_container = docker_state()["mode"] == "ephemeral"
    if not EPHEMERAL.exists() and not clone_container:
        return
    take_lease(fd, fcntl.LOCK_EX)
    try:
        teardown()
    except Failure as error:
        steps = ([f"docker rm -f {CONTAINER}"] if clone_container else []) + [f"rm -rf {EPHEMERAL}"]
        raise Failure(f"leftover ephemeral run could not be removed ({error}); clean up by hand: "
                      + "; ".join(steps)) from None
    take_lease(fd, kind)


def checked(argv, **kwargs):
    result = run(argv, **kwargs)
    if result.returncode:
        raise Failure(f"{argv[0]} failed with exit code {result.returncode}")
    return result


def reflink_files(source, target):
    target.mkdir(parents=True)
    checked(["chattr", "-C", str(target)])
    for path in sorted(source.iterdir()):
        if path.is_symlink() or not path.is_file() or path.name == "baseline.json":
            continue
        dest = target / path.name
        flags = checked(["lsattr", "-d", str(path)], capture_output=True, text=True).stdout.split()[0]
        dest.touch()
        checked(["chattr", "+C" if "C" in flags else "-C", str(dest)])
        checked(["cp", "--reflink=always", "--", str(path), str(dest)])
        dest.chmod(0o644)


def baseline():
    new = STATE / "baseline.new"
    old = STATE / "baseline.old"
    with lifecycle_lock():
        if docker_state()["container"] == "running":
            raise Failure("VM is running; stop it before win-vm baseline")
        shutil.rmtree(new, ignore_errors=True)
        reflink_files(HOME / ".windows", new)
    if not (new / "data.img").is_file():
        raise Failure("~/.windows has no data.img; bootstrap the persistent guest first")
    files = {}
    for path in sorted(new.iterdir()):
        files[path.name] = checked(["sha256sum", "--", str(path)], capture_output=True, text=True).stdout.split()[0]
    identity = {"captured_at": datetime.now(timezone.utc).isoformat(), "source": "~/.windows", "files": files}
    (new / "baseline.json").write_text(json.dumps(identity, indent=2) + "\n")
    for path in new.iterdir():
        path.chmod(0o444)
    shutil.rmtree(old, ignore_errors=True)
    if BASELINE.exists():
        BASELINE.rename(old)
    new.rename(BASELINE)
    shutil.rmtree(old, ignore_errors=True)
    print(json.dumps(identity), flush=True)
    return 0


@contextmanager
def ephemeral_lifecycle():
    with private_lock("ephemeral.lock") as fd, lifecycle_lock() as omarchy_fd:
        yield (fd, omarchy_fd) if omarchy_fd is not False else (fd,)


def teardown():
    with ephemeral_lifecycle():
        if docker_state()["mode"] == "ephemeral":
            checked(["docker", "rm", "-f", CONTAINER], stdout=sys.stderr)
        if EPHEMERAL.exists():
            try:
                shutil.rmtree(EPHEMERAL)
            except PermissionError:
                checked(["docker", "run", "--rm", "--pull=never", "--network=none",
                         "--mount", f"type=bind,source={EPHEMERAL},target=/cleanup",
                         "--entrypoint", "rm", "dockurr/windows", "-rf", "--", "/cleanup/storage", "/cleanup/shared"], stdout=sys.stderr)
                shutil.rmtree(EPHEMERAL)


class RunSignal(Exception):
    def __init__(self, signum):
        self.signum = signum


def guard(fd):
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)

    def terminate(signum, frame):
        raise RunSignal(signum)

    signal.signal(signal.SIGTERM, terminate)
    try:
        while os.read(0, 4096):
            pass
    except RunSignal:
        pass
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        try:
            teardown()
            HOLDER.unlink(missing_ok=True)
        finally:
            os.close(fd)
    return 0


def refuse_running(state):
    if state["container"] != "running":
        return
    if state["mode"] != "persistent":
        raise Failure("VM is running in ephemeral mode; stop it first")
    who = "win-vm up" if owned(state) else "not win-vm (Tobias or an Omarchy launch)"
    message = f"persistent VM is running; refusing ephemeral run (holder: {who}, started {state['started_at']})"
    try:
        ssh, sess = session(state["ip"]) if state["ip"] else (False, None)
        if ssh and sess and sess["state"] in ("console", "rdp", "disconnected"):
            message += f", session: {sess['state']}"
    except (Failure, OSError):
        pass
    raise Failure(message)


def startup_memory():
    result = checked(["docker-compose", "-f", COMPOSE, "config", "--format", "json"],
                     capture_output=True, text=True)
    try:
        size = json.loads(result.stdout)["services"]["windows"]["environment"]["RAM_SIZE"]
        match = re.fullmatch(r"([1-9][0-9]*)([MG])(?:i?B)?", size, re.IGNORECASE)
        if match is None:
            raise ValueError("unsupported size")
        return int(match[1]) * 1024**(2 if match[2].upper() == "M" else 3) + STARTUP_OVERHEAD
    except (ValueError, KeyError, TypeError):
        raise Failure("compose windows RAM_SIZE must be a positive integer in M or G units") from None


def admit_startup_memory(admission_class):
    # The enclosing run already owns win-vm. Explicit nested memory admission
    # rechecks host/caller headroom even for old callers whose outer peak is 0.
    while True:
        memory = startup_memory()
        checked(["heavy-lease", "run", "--wait", "--class", admission_class,
                 "--weight", "0", "--exclusive", "win-vm", "--memory", str(memory),
                 "--", sys.executable, "-c", "pass"])
        if startup_memory() == memory:
            return memory


@contextmanager
def admitted_lifecycle(admission_class, memory=None):
    while True:
        with lifecycle_lock() as locked:
            if docker_state()["container"] == "running" or (
                memory is not None and startup_memory() == memory
            ):
                yield locked
                return
        # Do not pin Omarchy's lifecycle lock while memory-blocked. Recheck the
        # state under that lock afterwards, so a queued running-state sample
        # can never authorize an unaccounted startup.
        memory = admit_startup_memory(admission_class)


def inherited_host_descriptors():
    descriptors = []
    for name, fd in json.loads(os.environ.get("HEAVY_LEASE_FDS", "{}")).items():
        try:
            lock = HOME / ".local/state/heavy-lease" / f"{name}.lock"
            if os.path.samestat(os.fstat(fd), lock.stat()):
                descriptors.append(fd)
        except OSError:
            # Token-only callers intentionally borrow their parent's ownership.
            continue
    return descriptors


def ephemeral_run(command, timeout, fd, admission_class):
    state = docker_state()
    refuse_running(state)
    if not (BASELINE / "baseline.json").is_file():
        raise Failure("no pinned baseline; run win-vm baseline with the VM stopped")
    memory = admit_startup_memory(admission_class)
    token = uuid.uuid4().hex
    holder = {"pid": os.getpid(), "guardian_pid": None, "command": command,
              "started_at": datetime.now(timezone.utc).isoformat(), "token": token}
    read_fd, write_fd = os.pipe()
    guardian = None
    process = None
    received = None
    signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)

    def forward(signum, frame):
        nonlocal received
        received = signum
        if process is not None and process.poll() is None:
            process.send_signal(signum)

    def check():
        if received is not None:
            raise RunSignal(received)
        if guardian is not None and guardian.poll() is not None:
            raise Failure("ephemeral guardian exited before the host command")

    previous = {sig: signal.signal(sig, forward) for sig in signals}
    try:
        write_holder(holder)
        guardian = subprocess.Popen(["systemd-run", "--user", "--scope", "--quiet", "--collect",
                                     f"--unit=win-vm-ephemeral-{token[:12]}", "--", sys.executable,
                                     str(SOURCE / "win-vm"), "__guard", str(fd)],
                                    stdin=read_fd, pass_fds=(fd, *inherited_host_descriptors()))
        os.close(read_fd)
        read_fd = None
        holder["guardian_pid"] = guardian.pid
        write_holder(holder)
        with ephemeral_lifecycle():
            check()
            state = docker_state()
            refuse_running(state)
            shutil.rmtree(EPHEMERAL, ignore_errors=True)
            reflink_files(BASELINE, EPHEMERAL / "storage")
            (EPHEMERAL / "shared").mkdir()
            override = {"services": {"windows": {"volumes": [
                {"type": "bind", "source": str(EPHEMERAL / "storage"), "target": "/storage"},
                {"type": "bind", "source": str(EPHEMERAL / "shared"), "target": "/shared"}]}}}
            (EPHEMERAL / "compose.yml").write_text(json.dumps(override) + "\n")
        with private_lock("ephemeral.lock") as clone_fd, admitted_lifecycle(admission_class, memory) as omarchy_fd:
            check()
            refuse_running(docker_state())
            lifecycle_fds = (clone_fd, omarchy_fd) if omarchy_fd is not False else (clone_fd,)
            checked(["docker-compose", "-f", COMPOSE, "-f", str(EPHEMERAL / "compose.yml"),
                     "up", "-d", "--force-recreate"], stdout=sys.stderr, pass_fds=lifecycle_fds)
        os.environ["WIN_VM_LEASE"] = token
        wait_ready(timeout, check=check)
        check()
        process = subprocess.Popen(command, env={**os.environ, "WIN_VM_LEASE": token})
        if received is not None:
            process.send_signal(received)
        code = process.wait()
        return code if code >= 0 else 128 - code
    except RunSignal as error:
        return 128 + error.signum
    finally:
        os.environ.pop("WIN_VM_LEASE", None)
        for sig in signals:
            signal.signal(sig, signal.SIG_IGN)
        try:
            teardown()
        finally:
            if read_fd is not None:
                os.close(read_fd)
            os.close(write_fd)
            if guardian is not None:
                guardian.wait()
                if guardian.returncode:
                    raise Failure(f"ephemeral guardian exited {guardian.returncode}; run win-vm status to clean up")
            else:
                HOLDER.unlink(missing_ok=True)
            for sig, handler in previous.items():
                signal.signal(sig, handler)


def record_start(state):
    if state["container"] != "running":
        raise Failure("Omarchy bring-up returned but the VM is not running")
    CACHE.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".started-by-win-vm-", dir=CACHE)
    try:
        with os.fdopen(fd, "w") as file:
            file.write(state["started_at"] + "\n")
        os.replace(name, MARKER)
    finally:
        Path(name).unlink(missing_ok=True)


def mounts_ready():
    anchor = Path(f"/var/lib/omarchy/windows/mounts/users/{os.getuid()}")
    result = run(["docker-compose", "-f", COMPOSE, "config", "--format", "json"],
                 capture_output=True, text=True)
    if result.returncode:
        return False
    try:
        services = json.loads(result.stdout)["services"]
        volumes = [volume for service in services.values() for volume in service.get("volumes", [])]
        for target, name in [("/storage", "storage"), ("/shared", "shared")]:
            matches = [volume for volume in volumes if volume.get("target") == target]
            if (len(matches) != 1 or matches[0].get("type") != "bind"
                    or matches[0].get("source") != str(anchor / name)):
                return False
    except (ValueError, KeyError, TypeError, AttributeError):
        return False
    for name, source in [("storage", HOME / ".windows"), ("shared", HOME / "Windows")]:
        target = anchor / name
        result = run(["findmnt", "-J", "-M", str(target), "-o", "TARGET,SOURCE,FSROOT"],
                     capture_output=True, text=True)
        if result.returncode:
            return False
        records = json.loads(result.stdout).get("filesystems", [])
        if len(records) != 1 or records[0]["target"] != str(target):
            return False
        try:
            if not os.path.samestat(source.stat(), target.stat()):
                return False
        except OSError:
            return False
    return True


def harden_mount_sources():
    # Omarchy's privileged preparation refuses sources not at exactly 0700, and its
    # `chmod 0700` keeps the setgid bit dockurr's samba sets on an empty share (2777).
    for source in (HOME / ".windows", HOME / "Windows"):
        try:
            os.chmod(source, 0o700)
        except OSError as error:
            raise Failure(f"cannot set {source} to 0700: {error}") from None


def up(timeout, admission_class):
    if os.environ.get("WIN_VM_LEASE"):
        return wait_ready(timeout, already=True, check=leased_state)
    # Preparation may wait for authorization, but cannot allocate a VM. Only
    # after it returns do we admit memory and start under the final lifecycle lock.
    with private_lock("up.lock"):
        with lifecycle_lock() as locked:
            already = docker_state()["container"] == "running"
            needs_prepare = not already and (not locked or not mounts_ready())
        if needs_prepare:
            print("Omarchy bind mounts need restoring; preparing without starting the VM.", file=sys.stderr, flush=True)
            harden_mount_sources()
            checked(["omarchy-windows-vm", "prepare"], stdout=sys.stderr)
        with admitted_lifecycle(admission_class) as locked:
            already = docker_state()["container"] == "running"
            if not already:
                if not locked or not mounts_ready():
                    raise Failure("Omarchy prepare did not provide safe VM mounts; refusing startup")
                result = run(["docker-compose", "-f", COMPOSE, "up", "-d"], stdout=sys.stderr)
                if result.returncode:
                    return result.returncode
                record_start(docker_state())
    return wait_ready(timeout, already)


def wait_ready(timeout, already=False, check=lambda: None):
    last = "no guest observation"
    try:
        with readiness_window(timeout) as deadline:
            while time.monotonic() < deadline:
                check()
                state = docker_state()
                try:
                    info = status(state, timeout=deadline - time.monotonic())
                    if info["ssh"] and info["session"]["state"] == "disconnected":
                        last = "session=disconnected; console handoff pending"
                        require_session(state["ip"], deadline - time.monotonic())
                        info = status(state, timeout=deadline - time.monotonic())
                    if info["ssh"] and active_session(info["session"]) and time.monotonic() < deadline:
                        check()
                        print(json.dumps({"already_running": already, "ip": info["ip"], "ssh": True, "session": info["session"]}), flush=True)
                        return 0
                    last = f"container={info['container']}; " + (f"session={info['session']['state']}" if info["ssh"] else "SSH unavailable")
                    if info.get("ssh_error"):
                        last += f"; {info['ssh_error']}"
                except TransportFailure as error:
                    last = str(error)
                time.sleep(min(2, max(0, deadline - time.monotonic())))
    except ReadinessExpired as error:
        last += f"; {error}"
    raise Failure(f"infrastructure readiness failed within {timeout:g}s: no active console or RDP session; last observation: {last}")


def down(force):
    with lifecycle_lock() as locked:
        state = docker_state()
        if not force and not owned(state):
            print(json.dumps({"stopped": False, "reason": "VM wasn't started by win-vm; leaving it alone"}))
            return 0
        argv = (["docker-compose", "-f", COMPOSE, "down"] if locked
                else ["omarchy-windows-vm", "stop"])
        result = run(argv, stdout=sys.stderr)
        if result.returncode == 0:
            MARKER.unlink(missing_ok=True)
    print(json.dumps({"stopped": result.returncode == 0, "exit_code": result.returncode}))
    return result.returncode


def scp(ip, src, dst, upload):
    if os.environ.get("WIN_VM_LEASE"):
        ip = leased_state()["ip"]
    user, _ = credentials()
    if not ip:
        raise Failure("Windows VM has no container IP")
    path = dst if upload else src
    path = path.replace("\\", "/")
    if re.match(r"^[A-Za-z]:/", path):
        path = "/" + path
    remote_path = f"{user}@{ip}:{path}"
    local_path = str(Path(src if upload else dst).expanduser().absolute())
    argv = ["scp", *ssh_options(), "--"] + ([local_path, remote_path] if upload else [remote_path, local_path])
    return run(argv).returncode


def job(ip, script, timeout, download=None, capture=False, detached=False):
    ident = uuid.uuid4().hex
    folder = ROOT + "\\jobs\\" + ident
    task = "win-vm-" + ident
    user, _ = credentials()
    script = "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; [Console]::OutputEncoding=[Text.UTF8Encoding]::new($false); $OutputEncoding=[Console]::OutputEncoding;\n" + script
    runners = {name: hashlib.sha256((SOURCE / name).read_bytes()).hexdigest()
               for name in ("run-job.ps1", "cleanup-job.ps1")}
    missing = "; ".join(
        f"if (!(Test-Path {ps_string(ROOT + chr(92) + name)}) -or "
        f"(Get-FileHash {ps_string(ROOT + chr(92) + name)} -Algorithm SHA256).Hash -ne '{digest}') {{ {ps_string(name)} }}"
        for name, digest in runners.items()
    )
    prepare = f"""
$r={ps_string(ROOT)}; $d={ps_string(folder)}
New-Item -ItemType Directory -Force -Path $r | Out-Null
$acl=[Security.AccessControl.DirectorySecurity]::new()
$acl.SetAccessRuleProtection($true,$false)
$acl.SetOwner([Security.Principal.SecurityIdentifier]::new('S-1-5-32-544'))
foreach($sid in @('S-1-5-32-544','S-1-5-18')) {{
 $rule=[Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new($sid),'FullControl','ContainerInherit,ObjectInherit','None','Allow')
 $acl.AddAccessRule($rule)
}}
Set-Acl -LiteralPath $r -AclObject $acl
New-Item -ItemType Directory -Force -Path $d | Out-Null
ConvertTo-Json -InputObject @({missing}) -Compress
"""
    setup = f"""
$n={ps_string(task)}
$a=New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File C:\\ProgramData\\win-vm\\run-job.ps1 -Id {ident}{' -Detached' if detached else ''}'
$p=New-ScheduledTaskPrincipal -UserId {ps_string(user)} -LogonType Interactive -RunLevel Highest
$s=New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Seconds {int(timeout) + 30}) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
Register-ScheduledTask -TaskName $n -Action $a -Principal $p -Settings $s | Out-Null
$before=(Get-ScheduledTaskInfo -TaskName $n).LastRunTime.Ticks
Start-ScheduledTask -TaskName $n
[Console]::Write($before)
"""
    try:
        needed = json.loads(remote(ip, prepare))
        if not isinstance(needed, list) or any(name not in runners for name in needed):
            raise Failure("invalid guest job helper inventory")
        for name in needed:
            code = scp(ip, str(SOURCE / name), ROOT + "\\" + name, True)
            if code:
                raise Failure(f"scp to guest failed with exit code {code}")
        scratch = HOME / ".cache/agent-tmp"
        scratch.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix="win-vm-", dir=scratch) as local:
            path = Path(local) / "job.ps1"
            path.write_text(script, encoding="utf-8-sig")
            code = scp(ip, str(path), folder + "\\job.ps1", True)
            if code:
                raise Failure(f"scp to guest failed with exit code {code}")
        before = int(remote(ip, setup))
        deadline = time.monotonic() + timeout
        interval = 0.25
        while True:
            poll = f"""
$i=Get-ScheduledTaskInfo -TaskName {ps_string(task)}
$t=Get-ScheduledTask -TaskName {ps_string(task)}
$e={ps_string(folder + chr(92) + 'exit.txt')}
$started=$i.LastRunTime.Ticks -ne {before}
$active=$t.State -in @('Queued','Running')
if ($started -and !$active) {{
 if (!(Test-Path $e)) {{ throw "Task ended without exit.txt (result $($i.LastTaskResult))" }}
 $o=[Convert]::ToBase64String([IO.File]::ReadAllBytes({ps_string(folder + chr(92) + 'stdout.txt')}))
 $err=[Convert]::ToBase64String([IO.File]::ReadAllBytes({ps_string(folder + chr(92) + 'stderr.txt')}))
 @{{done=$true;code=[int](Get-Content $e);stdout=$o;stderr=$err}} | ConvertTo-Json -Compress
}} else {{ @{{done=$false}} | ConvertTo-Json -Compress }}
"""
            result = json.loads(job_query(ip, poll, deadline))
            if result["done"]:
                if download and result["code"] == 0:
                    code = scp(ip, folder + "\\capture.png", download, False)
                    if code:
                        raise Failure(f"scp from guest failed with exit code {code}")
                    with Path(download).expanduser().open("rb") as image:
                        if image.read(8) != b"\x89PNG\r\n\x1a\n":
                            raise Failure("guest screenshot is not a PNG")
                stdout = base64.b64decode(result["stdout"])
                if not capture:
                    sys.stdout.buffer.write(stdout)
                    sys.stdout.buffer.flush()
                sys.stderr.write(decode_clixml(base64.b64decode(result["stderr"])))
                return (result["code"], stdout) if capture else result["code"]
            if time.monotonic() >= deadline:
                raise Failure(f"in-session job timed out after {timeout:g}s")
            # Each poll is a short SSH call; back off so long jobs stay cheap.
            interval = min(5, interval * 1.5)
            time.sleep(min(interval, max(0, deadline - time.monotonic())))
    finally:
        failed = sys.exc_info()[0] is not None
        cleanup = f"""
Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force
$n={ps_string(task)}; $d={ps_string(folder)}
& {ps_string(ROOT + chr(92) + 'cleanup-job.ps1')} -TaskName $n -Directory $d
if (-not $?) {{ throw 'Owned job cleanup failed; retained job directory' }}
"""
        try:
            remote(ip, cleanup)
        except Failure as error:
            print(f"win-vm: cleanup failed for {task}: {error}", file=sys.stderr)
            if not failed:
                raise


def require_session(ip, timeout):
    # Serialized so concurrent callers recheck the session instead of racing tscon.
    with readiness_window(min(timeout, READINESS_SECONDS)) as deadline, private_lock("handoff.lock"):
        ssh, sess = session(ip, deadline - time.monotonic())
        if not ssh:
            raise Failure("guest SSH unavailable; run win-vm bootstrap once")
        if sess["state"] == "none":
            raise Failure("tb not logged on (autologon?)")
        if active_session(sess):
            return
        if sess["state"] != "disconnected":
            raise Failure(f"guest session is not Active: {sess['state']}")
        remote(ip, f"""
$n='win-vm-console-handoff-{uuid.uuid4().hex}'
$a=New-ScheduledTaskAction -Execute 'tscon.exe' -Argument '{sess["id"]} /dest:console'
$p=New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
$s=New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Seconds 30) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
Register-ScheduledTask -TaskName $n -Action $a -Principal $p -Settings $s | Out-Null
try {{
 Start-ScheduledTask -TaskName $n
 $until=(Get-Date).AddSeconds({min(25, max(0, deadline - time.monotonic())):g})
 do {{
  $i=Get-ScheduledTaskInfo -TaskName $n
  $t=Get-ScheduledTask -TaskName $n
  if ($i.LastTaskResult -ne 267011 -and $t.State -notin @('Queued','Running')) {{ break }}
  if ((Get-Date) -ge $until) {{ throw 'Console handoff task timed out' }}
  Start-Sleep -Milliseconds 200
 }} while ($true)
 if ($i.LastTaskResult -ne 0) {{ throw "tscon failed with exit code $($i.LastTaskResult)" }}
}} finally {{ Unregister-ScheduledTask -TaskName $n -Confirm:$false }}
""", timeout=max(0, deadline - time.monotonic()))
        _, sess = session(ip, deadline - time.monotonic())
        if not sess or sess["state"] != "console":
            raise Failure("tscon completed without an Active console session")


def winapp_script(args):
    command_line = subprocess.list2cmdline(["ui", *args])
    return f"""$out=Join-Path $PSScriptRoot 'winapp.out'
$err=Join-Path $PSScriptRoot 'winapp.err'
$p=Start-Process -FilePath {ps_string(WINAPP)} -ArgumentList {ps_string(command_line)} -NoNewWindow -Wait -PassThru -RedirectStandardOutput $out -RedirectStandardError $err
$bytes=[IO.File]::ReadAllBytes($out)
[Console]::OpenStandardOutput().Write($bytes,0,$bytes.Length)
$bytes=[IO.File]::ReadAllBytes($err)
[Console]::OpenStandardError().Write($bytes,0,$bytes.Length)
exit $p.ExitCode
"""


def sha256(path):
    with path.open("rb") as file:
        return hashlib.file_digest(file, "sha256").hexdigest()


def bootstrap(stage_only):
    stage = CACHE / "bootstrap"
    stage.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(SOURCE / "bootstrap.ps1", stage / "bootstrap.ps1")
    batch = (SOURCE / "bootstrap.bat").read_text().splitlines()
    (stage / "bootstrap.bat").write_bytes(("\r\n".join(batch) + "\r\n").encode())
    shutil.copyfile(KEYS / "windows-vm-agent.pub", stage / "windows-vm-agent.pub")
    for name, (url, digest) in ARTIFACTS.items():
        path = stage / name
        if path.is_file() and sha256(path) == digest:
            continue
        print(f"Downloading {name}", file=sys.stderr)
        part = path.with_suffix(path.suffix + ".part")
        try:
            with urllib.request.urlopen(url, timeout=120) as response, part.open("wb") as file:
                shutil.copyfileobj(response, file)
            if sha256(part) != digest:
                raise Failure(f"SHA256 mismatch for {name}; upstream bytes changed, refusing to use them")
            part.replace(path)
        finally:
            part.unlink(missing_ok=True)
    hashes = {name: sha256(stage / name) for name in ARTIFACTS}
    (stage / "artifacts.json").write_text(json.dumps(hashes, indent=2) + "\n")
    print(json.dumps({"stage": str(stage), "artifacts": hashes}), flush=True)
    if not stage_only:
        user, password = credentials()
        if not password or "\n" in password or "\r" in password:
            raise Failure("missing or invalid WINDOWS_VM_PASSWORD in ~/.keys/windows-vm.env")
        # SDL's console callback reads one password line when /u is supplied.
        argv = ["sdl-freerdp3", "/v:127.0.0.1:3389", f"/u:{user}", "/cert:ignore",
                "/clipboard", "/dynamic-resolution", f"/drive:winvm,{stage}", "/from-stdin:force"]
        process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, start_new_session=True)
        process.stdin.write((password + "\n").encode())
        process.stdin.close()
        print(json.dumps({"rdp_pid": process.pid, "bootstrap": r"\\tsclient\winvm\bootstrap.bat"}))
    return 0


def parser():
    p = argparse.ArgumentParser(description=__doc__, epilog="Guest commands require one elevated bootstrap.bat run. Pin the stopped guest with baseline; run --ephemeral -- cmd uses a disposable clone and exclusive lease. up waits for SSH + active console or RDP; down stops only a container started by win-vm (use --force to override). No RDP lifecycle coupling.")
    sub = p.add_subparsers(dest="command", required=True)
    sub.add_parser("baseline", help="pin reflinked files from the stopped persistent guest")
    q = sub.add_parser("run", help="lease a disposable baseline clone for a host command")
    q.add_argument("--ephemeral", action="store_true", required=True)
    q.add_argument("--class", dest="admission_class", choices=ADMISSION_CLASSES, default="interactive", help="Host admission priority (default: interactive); startup estimates configured RAM plus 1 GiB overhead, not a hard limit.")
    q.add_argument("--timeout", type=float, default=READINESS_SECONDS, help=f"readiness timeout in seconds (default: {READINESS_SECONDS})")
    q.add_argument("args", nargs=argparse.REMAINDER)
    q = sub.add_parser("up", help="start headless and wait for guest SSH + active console or RDP")
    q.add_argument("--class", dest="admission_class", choices=ADMISSION_CLASSES, default="interactive", help="Host admission priority (default: interactive); an already-running VM needs no additional RAM.")
    q.add_argument("--timeout", type=float, default=READINESS_SECONDS, help=f"readiness timeout in seconds (default: {READINESS_SECONDS})")
    q = sub.add_parser("down", help="stop only the container started by win-vm")
    q.add_argument("--force", action="store_true")
    sub.add_parser("status", help="JSON state, SSH, session and lifecycle ownership")
    for name in ["exec", "gui", "uia"]:
        q = sub.add_parser(name, help={"exec": "non-interactive PowerShell script", "gui": "launch an exe in tb's session; returns JSON pid", "uia": "run winapp ui arguments in tb's session"}[name])
        if name != "exec":
            q.add_argument("--timeout", type=float, default=120, help="job timeout before command arguments (default: 120)")
        if name == "gui":
            q.add_argument("--wait", action="store_true", help="block until the process exits; exit with its code (exact code in JSON)")
        q.add_argument("args", nargs=argparse.REMAINDER)
    for name in ["put", "get"]:
        q = sub.add_parser(name, help="SFTP copy; Windows drive paths and UNC supported")
        q.add_argument("src")
        q.add_argument("dst")
    q = sub.add_parser("screenshot", help="capture app or whole desktop; copy and validate PNG")
    q.add_argument("out")
    q.add_argument("--app", type=int)
    q.add_argument("--timeout", type=float, default=120)
    q = sub.add_parser("bootstrap", help="stage pinned installers; optionally open detached SDL RDP")
    q.add_argument("--stage-only", action="store_true")
    return p


def main():
    # Internal: the ephemeral run's guardian, started through systemd-run.
    if sys.argv[1:2] == ["__guard"]:
        return guard(int(sys.argv[2]))
    admitted = sys.argv[1:2] == ["__host_admitted"]
    if admitted:
        if not os.environ.get("HEAVY_LEASE_TOKEN"):
            raise Failure("internal host admission requires a live heavy-lease context")
        del sys.argv[1]
    p = parser()
    args = p.parse_args()
    if hasattr(args, "timeout") and args.timeout <= 0:
        p.error("--timeout must be positive")
    if getattr(args, "wait", False) and args.timeout * 1000 > 2**31 - 1:
        p.error("gui --wait --timeout is limited to 2147483 seconds (WaitForExit takes Int32 milliseconds)")
    if hasattr(args, "args"):
        if args.args[:1] == ["--"]:
            args.args.pop(0)
        if not args.args:
            p.error(f"{args.command} requires command arguments")
        if args.command == "exec" and len(args.args) != 1:
            p.error("exec requires exactly one PowerShell script argument")
    if args.command == "status":
        if not os.environ.get("WIN_VM_LEASE"):
            try:
                with command_lease("status"):
                    pass
            except Leased:
                pass
        print(json.dumps(status()))
        return 0
    if args.command in ("up", "run") and not admitted and not os.environ.get("WIN_VM_LEASE"):
        # Read-only refusal before queuing; authoritative recovery and lifecycle
        # checks happen after host admission. Taking the guest lease here would
        # reject a concurrent ephemeral owner instead of queuing behind it.
        if args.command == "run":
            state = docker_state()
            if state["mode"] == "persistent":
                refuse_running(state)
                if not EPHEMERAL.exists() and not (BASELINE / "baseline.json").is_file():
                    raise Failure("no pinned baseline; run win-vm baseline with the VM stopped")
        # Named ownership is not a RAM allocation. The actual startup path
        # separately admits config-derived growth under this same live lease.
        os.execvp("heavy-lease", ["heavy-lease", "run", "--wait", "--class", args.admission_class,
                                "--weight", "0", "--exclusive", "win-vm", "--memory", "0",
                                "--", sys.executable, str(SOURCE / "win-vm"), "__host_admitted", *sys.argv[1:]])
    with command_lease(args.command) as fd:
        if args.command == "baseline":
            return baseline()
        if args.command == "run":
            return ephemeral_run(args.args, args.timeout, fd, args.admission_class)
        return dispatch(args)


def dispatch(args):
    if args.command == "bootstrap":
        return bootstrap(args.stage_only)
    if args.command == "up":
        return up(args.timeout, args.admission_class)
    if args.command == "down":
        return down(args.force)
    state = docker_state()
    if args.command == "status":
        print(json.dumps(status(state)))
        return 0
    ip = state["ip"]
    if args.command == "exec":
        script = args.args[0]
        script = "$global:LASTEXITCODE=0; & { " + script + "\n}; $ok=$?; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; if (!$ok) { exit 1 }"
        return powershell(ip, script, stream=True)
    if args.command in ("put", "get"):
        return scp(ip, args.src, args.dst, args.command == "put")
    require_session(ip, args.timeout)
    if args.command == "gui":
        # Start-Process joins ArgumentList itself; apply Windows argv quoting once.
        exe, *values = args.args
        command_line = subprocess.list2cmdline(values)
        script = f"""$ErrorActionPreference='Stop'
$exe={ps_string(exe)}; $wd=Split-Path -Parent $exe
if (!$wd) {{ $exe=(Get-Command $exe -ErrorAction Stop).Source; $wd=Split-Path -Parent $exe }}
$params=@{{FilePath=$exe;WorkingDirectory=$wd;PassThru=$true}}
$arguments={ps_string(command_line)}
if ($arguments) {{ $params.ArgumentList=$arguments }}
$p=Start-Process @params
"""
        if not args.wait:
            return job(ip, script + "@{pid=$p.Id} | ConvertTo-Json -Compress\n", args.timeout, detached=True)
        # The handle keeps ExitCode readable; on timeout, kill the whole tree before failing.
        script += f"""$null=$p.Handle
if (!$p.WaitForExit({int(args.timeout * 1000)})) {{
 & taskkill.exe /T /F /PID $p.Id | Out-Null
 @{{pid=$p.Id;timed_out=$true}} | ConvertTo-Json -Compress
 exit 0
}}
@{{pid=$p.Id;exit_code=$p.ExitCode}} | ConvertTo-Json -Compress
"""
        code, stdout = job(ip, script, args.timeout + 60, capture=True)
        if code:
            return code
        result = json.loads(stdout)
        if result.get("timed_out"):
            raise Failure(f"process {result['pid']} still running after {args.timeout:g}s; killed its process tree")
        print(json.dumps(result))
        # Host exit statuses are 8-bit; the exact Windows code stays in the JSON.
        return result["exit_code"] if 0 <= result["exit_code"] <= 255 else 255
    if args.command == "uia":
        script = winapp_script(args.args)
        return job(ip, script, args.timeout)
    if args.command == "screenshot":
        if args.app is not None:
            script = winapp_script(["screenshot", "-a", str(args.app), "--output", "capture.png"])
        else:
            script = """$ErrorActionPreference='Stop'
Add-Type -AssemblyName System.Windows.Forms,System.Drawing
$r=[Windows.Forms.SystemInformation]::VirtualScreen
$b=New-Object Drawing.Bitmap($r.Width,$r.Height)
$g=[Drawing.Graphics]::FromImage($b)
try { $g.CopyFromScreen($r.Left,$r.Top,0,0,$r.Size); $b.Save((Join-Path $PSScriptRoot 'capture.png'),[Drawing.Imaging.ImageFormat]::Png) }
finally { $g.Dispose(); $b.Dispose() }
"""
        return job(ip, script, args.timeout, download=args.out)
    raise Failure("unknown command")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (Failure, OSError, ValueError, urllib.error.URLError) as error:
        print(f"win-vm: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
