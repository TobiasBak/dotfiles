#!/usr/bin/env python3
import argparse
from datetime import datetime, timedelta, timezone
import fcntl
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.error import HTTPError
from urllib.request import Request, urlopen


REPO = "TobiasBak/dotfiles"
ROSTER = ("claude-opus-5-5", "gpt-6.1-sol", "claude-haiku-5-5")
SOURCES = {
    "zen": ("https://opencode.ai/zen/v1/models", "zen.json"),
    "go": ("https://opencode.ai/zen/go/v1/models", "go.json"),
    "models.dev": ("https://models.dev/api.json", "models.dev.json"),
}
AA_URL = "https://artificialanalysis.ai/api/v2/data/llms/models"


def error_status(error):
    return f"HTTP {error.code}" if isinstance(error, HTTPError) else type(error).__name__


def fetch_json(url, headers=None):
    request = Request(url, headers={"User-Agent": "opencode-free (dotfiles)", **(headers or {})})
    with urlopen(request, timeout=30) as response:
        return json.load(response)


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default


def fetch_sources(fixture):
    sources = {}
    for source, (url, filename) in SOURCES.items():
        try:
            sources[source] = json.loads((fixture / filename).read_text()) if fixture else fetch_json(url)
        except Exception as error:
            raise ValueError(f"fetching {source} failed: {error_status(error)}") from None
    for plan in ("zen", "go"):
        data = sources[plan]
        if (not isinstance(data, dict) or not isinstance(data.get("data"), list)
                or any(not isinstance(row, dict) or not isinstance(row.get("id"), str)
                       or not row["id"] for row in data["data"])):
            raise ValueError(f"invalid {plan} live list")
    catalog = sources["models.dev"]
    for provider in ("opencode", "opencode-go"):
        if (not isinstance(catalog, dict) or not isinstance(catalog.get(provider), dict)
                or not isinstance(catalog[provider].get("models"), dict)
                or any(not isinstance(model, dict) or not isinstance(model.get("cost") or {}, dict)
                       for model in catalog[provider]["models"].values())):
            raise ValueError(f"invalid models.dev provider {provider}")
    return sources


def fetch_aa(fixture):
    try:
        if fixture:
            path = fixture / "aa.json"
            if not path.exists():
                return None, "missing in fixture"
            data = json.loads(path.read_text())
        else:
            path = Path(os.environ.get("OPENCODE_FREE_AA_KEY_FILE", "~/.keys/artificial-analysis")).expanduser()
            if not path.exists():
                return None, f"missing key at {path}"
            key = path.read_text().strip()
            if not key:
                return None, f"missing key at {path}"
            data = fetch_json(AA_URL, {"x-api-key": key})
        if not isinstance(data, dict) or not isinstance(data.get("data"), list):
            raise ValueError()
        if any(not isinstance(row, dict) for row in data["data"]):
            raise ValueError()
        return data["data"], None
    except Exception as error:
        return None, error_status(error)


def normalize(value):
    value = re.sub(r"(?:-free| free)$", "", (value or "").lower())
    return re.sub(r"[^a-z0-9]+", "-", value).strip("-")


def number(value):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) else None


def aa_index(rows):
    index = {}
    for row in rows or []:
        evaluations = row.get("evaluations") or {}
        pricing = row.get("pricing") or {}
        scores = {
            "slug": row.get("slug"),
            "intelligence": number(evaluations.get("artificial_analysis_intelligence_index")),
            "coding": number(evaluations.get("artificial_analysis_coding_index")),
            "speed": number(row.get("median_output_tokens_per_second")),
            "price": number(pricing.get("price_1m_blended_3_to_1")),
        }
        rank = scores["intelligence"] if scores["intelligence"] is not None else -math.inf
        name = row.get("name") or ""
        for value in (row.get("slug"), name, re.sub(r"\([^)]*\)", "", name)):
            key = normalize(value)
            if not key:
                continue
            previous = index.get(key)
            old_rank = previous["intelligence"] if previous and previous["intelligence"] is not None else -math.inf
            if previous is None or rank > old_rank:
                index[key] = scores
    return index


def aa_match(index, model_id, name):
    return index.get(normalize(model_id)) or index.get(normalize(name))


def build_snapshot(sources, index, aa_status):
    catalog = sources["models.dev"]
    catalogs = {"zen": catalog["opencode"]["models"], "go": catalog["opencode-go"]["models"]}
    live = {plan: {row["id"] for row in sources[plan]["data"]} for plan in catalogs}
    models = {}
    for model_id in sorted(live["zen"] | live["go"]):
        name = (catalogs["zen"].get(model_id, {}).get("name")
                or catalogs["go"].get(model_id, {}).get("name") or model_id)
        plans = sorted(plan for plan in live if model_id in live[plan])
        free_on = []
        for plan in plans:
            entry = catalogs[plan].get(model_id, {})
            cost = entry.get("cost") or {}
            if entry.get("status") != "deprecated" and cost.get("input") == 0 and cost.get("output") == 0:
                free_on.append(plan)
        models[model_id] = {"name": name, "plans": plans, "free_on": free_on, "aa": aa_match(index, model_id, name)}
    roster = {}
    for model_id in ROSTER:
        name = catalogs["zen"].get(model_id, {}).get("name") or model_id
        roster[model_id] = {"name": name, "aa": aa_match(index, model_id, name)}
    return {
        "taken_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "aa_status": aa_status,
        "models": models,
        "roster": roster,
    }


def diff_events(previous, snapshot):
    events = []
    old_models = previous["models"] if previous else {}
    new_models = snapshot["models"]

    def emit(event, model_id, detail):
        events.append({"at": snapshot["taken_at"], "event": event, "id": model_id, "detail": detail})

    for model_id in sorted(old_models.keys() | new_models.keys()):
        old, new = old_models.get(model_id), new_models.get(model_id)
        name = (new or old)["name"]
        if previous is None:
            if new["free_on"]:
                emit("first_seen_free", model_id, name)
            continue
        if old is None:
            emit("added", model_id, name)
        if new is None:
            emit("removed", model_id, name)
        was_free, is_free = bool(old and old["free_on"]), bool(new and new["free_on"])
        if is_free and not was_free:
            emit("newly_free", model_id, name)
        if was_free and not is_free:
            emit("no_longer_free", model_id, name)
        if old and new and old["aa"] and new["aa"]:
            changes = [f"{field}: {old['aa'][field]}→{new['aa'][field]}"
                       for field in ("intelligence", "coding", "price") if old["aa"][field] != new["aa"][field]]
            if changes:
                emit("score_changed", model_id, "; ".join(changes))
    return events


def free_windows(history):
    windows = []
    opened = {}
    for event in history:
        if event["event"] in ("first_seen_free", "newly_free"):
            window = {"id": event["id"], "name": event["detail"], "start": event["at"],
                      "baseline": event["event"] == "first_seen_free", "end": None}
            windows.append(window)
            opened[event["id"]] = window
        elif event["event"] == "no_longer_free":
            window = opened.pop(event["id"], None)
            if window:
                window["end"] = event["at"]
    return sorted(windows, key=lambda window: (window["start"], window["id"]), reverse=True)


def start_date(window):
    return ("≤ " if window["baseline"] else "") + window["start"][:10]


def cell(value):
    return str(value).replace("|", "\\|").replace("\n", " ").replace("\r", " ")


def markdown_row(values):
    return "| " + " | ".join(cell(value) for value in values) + " |"


def format_number(value, digits):
    return "—" if value is None else f"{value:.{digits}f}"


def render_table(snapshot, history):
    taken_at = datetime.fromisoformat(snapshot["taken_at"])
    lines = [f"OpenCode free models, snapshot {taken_at:%Y-%m-%d %H:%M} UTC. "
             "Scores: [Artificial Analysis](https://artificialanalysis.ai/)."]
    if snapshot["aa_status"]:
        lines.append(f"AA scores missing: {snapshot['aa_status']}.")
    lines.extend(["", "| Model | ID | Plans | Free since | AA intel | AA coding | tok/s | $/1M blended | Closest of ours |",
                  "| --- | --- | --- | --- | --- | --- | --- | --- | --- |"])
    windows = free_windows(history)
    opened = {window["id"]: window for window in windows if window["end"] is None}
    roster = [model for model in snapshot["roster"].values()
              if model["aa"] and model["aa"]["intelligence"] is not None]

    def sort_key(item):
        score = item[1]["aa"]
        intelligence = score["intelligence"] if score else None
        return (-(intelligence if intelligence is not None else -math.inf), item[0])

    for model_id, model in sorted(snapshot["models"].items(), key=sort_key):
        if not model["free_on"]:
            continue
        scores = model["aa"] or {}
        intelligence = scores.get("intelligence")
        closest = "—"
        if intelligence is not None and roster:
            ours = min(roster, key=lambda candidate: abs(intelligence - candidate["aa"]["intelligence"]))
            closest = f"{ours['name']} ({ours['aa']['intelligence']:.1f})"
        lines.append(markdown_row([
            model["name"], model_id,
            ", ".join(plan + (" (free)" if plan in model["free_on"] else "") for plan in model["plans"]),
            start_date(opened[model_id]) if model_id in opened else "—",
            format_number(intelligence, 1), format_number(scores.get("coding"), 1),
            format_number(scores.get("speed"), 0), format_number(scores.get("price"), 2), closest,
        ]))
    lines.extend(["", 'OpenCode publishes no end dates; free models are "limited time".'])
    ended = [window for window in windows if window["end"]
             and datetime.fromisoformat(window["end"]) >= taken_at - timedelta(days=30)]
    if ended:
        lines.extend(["", "## Free windows ended in the last 30 days", "",
                      "| Model | ID | Start | End |", "| --- | --- | --- | --- |"])
        for window in ended:
            name = snapshot["models"].get(window["id"], {}).get("name", window["name"])
            lines.append(markdown_row([name, window["id"], start_date(window), window["end"][:10]]))
    return "\n".join(lines) + "\n"


def render_history(history):
    lines = ["| Model | ID | Start | End |", "| --- | --- | --- | --- |"]
    for window in free_windows(history):
        lines.append(markdown_row([window["name"], window["id"], start_date(window),
                                   window["end"][:10] if window["end"] else "ongoing"]))
    return "\n".join(lines) + "\n"


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False) as handle:
            temporary = Path(handle.name)
            handle.write(content)
        temporary.replace(path)
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)


def save_json(path, value):
    atomic_write(path, json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def command(args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=60)
    if result.returncode:
        raise ValueError(f"{args[0]} {args[1]} failed (exit {result.returncode})")
    return result.stdout


def change_lines(events):
    labels = {"newly_free": "Newly free", "no_longer_free": "No longer free"}
    return "\n".join(f"{labels[event['event']]}: {event['detail']}" for event in events)


def publish(state, table, data):
    scratch = Path.home() / ".cache/agent-tmp"
    scratch.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="opencode-free-publish-", dir=scratch) as folder:
        body = Path(folder) / "body.md"
        body.write_text(table)
        issues = json.loads(command(["gh", "issue", "list", "-R", REPO, "--label", "opencode-free",
                                     "--state", "open", "--json", "number", "--limit", "1"]))
        if not issues:
            output = command(["gh", "issue", "create", "-R", REPO, "--title", "OpenCode free models",
                              "--label", "opencode-free", "--body-file", str(body)])
            match = re.search(r"/issues/(\d+)", output)
            if not match:
                raise ValueError("gh issue create returned no issue URL")
            issue = int(match.group(1))
            atomic_write(state / "published.md", table)
        else:
            issue = issues[0]["number"]
            published = state / "published.md"
            if not published.exists() or published.read_text() != table:
                command(["gh", "issue", "edit", str(issue), "-R", REPO, "--body-file", str(body)])
                atomic_write(published, table)
        if data["pending"]:
            lines = change_lines(data["pending"])
            command(["notify-send", "OpenCode free models changed", lines])
            body.write_text(lines + f"\n\nTracker: https://github.com/{REPO}/issues/{issue}\n")
            command(["gh", "issue", "comment", str(issue), "-R", REPO, "--body-file", str(body)])
            data["pending"] = []
            save_json(state / "state.json", data)


def run(state, fixture, no_publish):
    state.mkdir(parents=True, exist_ok=True)
    with (state / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = read_json(state / "state.json", {"snapshot": None, "history": [], "pending": []})
        sources = fetch_sources(fixture)
        rows, aa_status = fetch_aa(fixture)
        try:
            index = aa_index(rows)
        except (AttributeError, TypeError, ValueError) as error:
            index, aa_status = {}, error_status(error)
        snapshot = build_snapshot(sources, index, aa_status)
        events = diff_events(data["snapshot"], snapshot)
        history = data["history"] + events
        pending = data["pending"] + [event for event in events
                                     if event["event"] in ("newly_free", "no_longer_free")]
        data = {"snapshot": snapshot, "history": history, "pending": pending}
        save_json(state / "state.json", data)
        if events:
            for event in events:
                print(f"{event['event']}: {event['id']}: {event['detail']}")
        else:
            print("no changes")
        if not no_publish:
            try:
                publish(state, render_table(snapshot, history), data)
            except Exception as error:
                message = str(error) if isinstance(error, ValueError) else error_status(error)
                raise ValueError(f"publish failed: {message}") from None


def main():
    parser = argparse.ArgumentParser(description="Track live OpenCode free models and their Artificial Analysis scores.")
    commands = parser.add_subparsers(dest="command")
    commands.add_parser("table", help="Print the latest saved table without network access")
    commands.add_parser("history", help="Print free windows, newest first")
    runner = commands.add_parser("run", help="Fetch a snapshot, record changes and publish the tracker issue")
    runner.add_argument("--fixture", type=Path, metavar="DIR", help="Read zen.json, go.json, models.dev.json and optional aa.json")
    runner.add_argument("--no-publish", action="store_true", help="Save locally without GitHub or desktop notifications")
    args = parser.parse_args()
    state = Path(os.environ.get("OPENCODE_FREE_STATE", str(Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "opencode-free"))).expanduser()
    try:
        if args.command == "run":
            run(state, args.fixture, args.no_publish)
        else:
            data = read_json(state / "state.json")
            if data is None:
                raise ValueError("no snapshot; run opencode-free run")
            print(render_history(data["history"]) if args.command == "history"
                  else render_table(data["snapshot"], data["history"]), end="")
        return 0
    except (OSError, ValueError) as error:
        print(f"opencode-free: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
