{
  "providerInstances": {
    "claudeAgent": {
      "driver": "claudeAgent",
      "enabled": true,
      "config": {
        "binaryPath": "~/.local/bin/gah-claude"
      }
    },
    "pi": {
      "driver": "pi",
      "enabled": true,
      "config": {
        "binaryPath": "/home/tb/.local/bin/gah-pi"
      }
    },
    "opencode": {
      "driver": "opencode",
      "enabled": true
    },
    "codex": {
      "driver": "codex",
      "enabled": true,
      "config": {
        "binaryPath": "/home/tb/.local/bin/gah-codex"
      }
    }
  }
}
