{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#97f3f9",
          "properties": {
            "style": "agnoster_short"
          },
          "template": "{{ .Path }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#ff79c6",
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ if .HEAD }}[{{ if gt .Ahead 0 }}⇡{{ end }}{{ if gt .Behind 0 }}⇣{{ end }}{{ .HEAD }}]{{ if or .Working.Changed .Staging.Changed }}[{{ if .Working.Changed }}!{{ end }}{{ if .Staging.Changed }}+{{ end }}]{{ end }}{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#48d269",
          "template": "→ "
        }
      ]
    }
  ]
}
